                                        <value>LOINC</value>
                                    </terminology_id>
                                    <code_string>[LOINC::86904-0]</code_string>
                                </value>
                            </items>
                            <items code="at0046">
                                <value>
                                    <terminology_id>
                                        <value>LOINC</value>
                                    </terminology_id>
                                    <code_string>[LOINC::2614-6]</code_string>
                                </value>
                            </items>
                        </term_bindings>
                    </children>
