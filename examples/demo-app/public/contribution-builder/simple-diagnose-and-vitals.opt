        <archetype_id>
            <value>openEHR-EHR-COMPOSITION.encounter.v1</value>
        </archetype_id>
        <template_id>
            <value>simple-diagnose-and-vitals</value>
        </template_id>
        <term_definitions code="at0001">
            <items id="text">Tree</items>
            <items id="description">@ internal @</items>
        </term_definitions>
        <term_definitions code="at0002">
            <items id="text">Extension</items>
            <items id="description">Additional information required to capture local context or to align with other reference models/formalisms.</items>
            <items id="comment">e.g. Local hospital departmental infomation or additional metadata to align with FHIR or CIMI equivalents.</items>
        </term_definitions>
        <term_definitions code="at0000">
            <items id="text">simple-diagnose-and-vitals</items>
            <items id="description">Interaction, contact or care event between a subject of care and healthcare provider(s).</items>
        </term_definitions>
    </definition>
    <ontology archetype_id="openEHR-EHR-COMPOSITION.encounter.v1">
        <term_definitions language="sv">
            <items code="at0001">
                <items id="text">Tree</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0002">
                <items id="text">Extra information</items>
                <items id="description">Extra information som krävs för att fånga lokal kontext eller för anpassning till andra referensmodeller och formalismer.</items>
                <items id="comment">Exempelvis information om en lokal sjukhusavdelning eller ytterligare metadata för anpassning till FHIR- eller CIMI-motsvarigheter.</items>
            </items>
            <items code="at0000">
                <items id="text">simple-diagnose-and-vitals</items>
                <items id="description">Interaktion, kontakt eller vårdhändelse mellan vårdtagare och vårdgivare inom hälso- och sjukvården.</items>
            </items>
        </term_definitions>
        <term_definitions language="de">
            <items code="at0001">
                <items id="text">Tree</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0002">
                <items id="text">Erweiterung</items>
                <items id="description">Zusätzliche Informationen, zur Erfassung lokaler Inhalte oder Anpassung an andere Referenzmodelle / Formalismen.</items>
                <items id="comment">Zum Beispiel Informationen zu lokalen Krankenhausabteilungen oder zusätzliche Metadaten zur Übereinstimmung mit FHIR- oder CIMI-Äquivalenten.</items>
            </items>
            <items code="at0000">
                <items id="text">simple-diagnose-and-vitals</items>
                <items id="description">Interaktion, Kontakt oder Versorgungsereignis, zwischen einem Versorgungsempfänger und einem Gesundheitsdienstleister.</items>
            </items>
        </term_definitions>
    </ontology>
    <component_ontologies archetype_id="openEHR-EHR-EVALUATION.problem_diagnosis.v1">
        <term_definitions language="sv">
            <items code="at0001">
                <items id="text">structure</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0002">
                <items id="text">Problem/Diagnos namn</items>
                <items id="description">Identifiering av problemet eller diagnosen efter namn.</items>
                <items id="comment">Kodning av namnet på problemet eller diagnosen med en terminologi är att föredra, om det är tillämpligt.</items>
            </items>
            <items code="at0003">
                <items id="text">Datum och tid för kliniskt erkänd</items>
                <items id="description">Uppskattat eller reellt datum coh tid som diagnosen eller problemet erkändes av sjukvårdspersonal.</items>
                <items id="comment">Partiella datum är acceptabla. Om patienten är under ett år, då är det fullständiga datumet eller ett minimum av månad och år nödvändigt för korrekta åldersberäkningar exempelvis om de används för beslutsstöd. Data som registreras och importeras som "Ålder vid tidpunkten för kliniskt erkännande" ska omvandlas till ett datum med hjälp av patientens födelsedatum.</items>
            </items>
            <items code="at0005">
                <items id="text">Svårighetsgrad</items>
                <items id="description">En bedömning av problemets eller diagnosens totala svårighetsgrad.</items>
                <items id="comment">Om svårighetsgraden har lagts till i Problem- och diagnos-namnet via förkoordinerade koder, blir detta fält överflödigt. Obs: mer specifik gradering av svårighetsgrad kan registreras i fältet ”specifika detaljer.”</items>
            </items>
            <items code="at0009">
                <items id="text">Klinisk beskrivning</items>
                <items id="description">En beskrivning av problemet eller diagnosen.</items>
                <items id="comment">Används för att ge bakgrund och kontext, inklusive utveckling, episoder eller exacerbationer, framsteg och andra relevanta detaljer om problemet eller diagnosen.</items>
            </items>
            <items code="at0012">
                <items id="text">Anatomisk plats</items>
                <items id="description">Identifiering av problemets eller diagnosens anatomiska plats.</items>
                <items id="comment">Kodning av den anatomiska platsens namn med en terminologi är att föredra, om det är tillämpligt. Använd det här fältet för att dokumentera förkoordinerade anatomiska platser. Om kraven för att dokumentera den anatomiska platsen bestäms automatiskt av applikationen eller kräver mer komplicerad modellering som exempelvis relativa platser, använd i så fall Cluster.anatomical_location eller cluster. relative_location inom "Strukturerad anatomisk plats '-fältet i denna arketyp. I detta fält är det möjligt att dokumentera kliniska scenarier som exempelvis att beskriva ett utslag på flera platser, men där alla andra egenskaper är identiska. Om den anatomiska platsen ingår i problem-och diagnos-namnet via förkoordinerade koder, blir detta fält överflödigt.</items>
            </items>
            <items code="at0030">
                <items id="text">Datum och tid för upplösning</items>
                <items id="description">Uppskattat eller reellt datum och tid för upplösning eller remission av detta problem eller diagnos, som fastställts av sjukvårdspersonal.</items>
                <items id="comment">Partiella datum är acceptabla. Om patienten är under ett år är det fullständiga datumet eller ett minimum av månad och år nödvändigt för korrekta åldersberäkningar, exempelvis om de används för beslutsstöd. Data som registreras och importeras som "Ålder vid tidpunkten för upplösning" ska konverteras till ett datum med hjälp av patientens födelsedatum.</items>
            </items>
            <items code="at0032">
                <items id="text">Tree</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0039">
                <items id="text">Strukturerad anatomisk plats</items>
                <items id="description">En strukturerad anatomisk plats för problemet eller diagnosen.</items>
                <items id="comment">Använd det här fältet för att infoga CLUSTER.anatomical_location eller CLUSTER.relative_location-arketyper om den anatomiska platsen bestäms automatiskt av applikationen eller kräver mer komplicerad modellering som exempelvis relativa platser. Om den anatomiska platsen är inkluderad i problem- och diagnos-namnet via förkoordinerade koder, blir detta fält överflödigt.</items>
            </items>
            <items code="at0043">
                <items id="text">Specifika detaljer</items>
                <items id="description">Detaljer som krävs för att kunna dokumenteras som unika egenskaper i den här problem eller diagnos arketypen.</items>
                <items id="comment">Fältet kan innehålla strukturerad detalj om klassificering eller stadieindelning av diagnosen diagnostiska kriterier, klassificeringskriterier eller formella bedömningar av svårighetsgrad, såsom gemensamma terminologikriterier för biverkningar.</items>
            </items>
            <items code="at0046">
                <items id="text">Status</items>
                <items id="description">Strukturerade detaljer för plats-, domän-, episod-eller arbetsflödes specifika aspekter av diagnosprocessen.
</items>
                <items id="comment">Använd status- eller kontextbestämningar med omsorg, pga. varierande användning i praktiken samt pga. att driftskompabilitet inte kan garanteras om inte användningen är tydligt definierad i gruppen exempelvis:
Status: Aktiv och inaktiv, utredd och i remission Utvecklingsstatus: Initial, interimistisk preliminär och slutlig
Temporal status: Nuvarande och tidigare 
Episodicitet status: Första, nytt och pågående
Inskrivningsstatus: Inskrivning och utskrivning Prioritetsstatus: Primär och sekundär.</items>
            </items>
            <items code="at0047">
                <items id="text">Mild</items>
                <items id="description">Problemet eller diagnosen stör inte normal aktivitet eller kan orsaka hälsoskador om den lämnas obehandlad.</items>
            </items>
            <items code="at0048">
                <items id="text">Medel</items>
                <items id="description">Problemet eller diagnosen orsakar störningar i normal aktivitet eller kommer att skada hälsan om den lämnas obehandlad.</items>
            </items>
            <items code="at0049">
                <items id="text">Svår</items>
                <items id="description">Problemet eller diagnosen förhindrar normal aktivitet eller allvarligt kommer att skada hälsan om den lämnas obehandlad.</items>
            </items>
            <items code="at0069">
                <items id="text">Kommentar</items>
                <items id="description">En extra beskrivning av problemet eller diagnosen som inte tagits upp i andra fält.</items>
            </items>
            <items code="at0070">
                <items id="text">Senast uppdaterad</items>
                <items id="description">Datumet då problemet eller diagnosen senast uppdaterades.</items>
            </items>
            <items code="at0071">
                <items id="text">Extra information</items>
                <items id="description">Ytterligare uppgifter som krävs för att fånga lokalt innehåll eller för anpassning till andra referens modeller och formalismer.</items>
                <items id="comment">Exempelvis: lokala informationskrav eller ytterligare metadata för anpassning till FHIR-eller CIMI -motsvarigheter.</items>
            </items>
            <items code="at0072">
                <items id="text">Förlopp</items>
                <items id="description">Beskrivning av problemets eller diagnosen förlopp sedan debuten.</items>
            </items>
            <items code="at0073">
                <items id="text">Diagnostisk säkerhet</items>
                <items id="description">Säkerhetsgraden för identifiering av diagnos.</items>
            </items>
            <items code="at0074">
                <items id="text">Misstänkt</items>
                <items id="description">Diagnosen har identifierats med en låg grad av säkerhet.</items>
            </items>
            <items code="at0075">
                <items id="text">Sannolik</items>
                <items id="description">Diagnosen har identifierats med en hög grad av säkerhet.</items>
            </items>
            <items code="at0076">
                <items id="text">Bekräftad</items>
                <items id="description">Diagnosen har bekräftats mot kända kriterier.</items>
            </items>
            <items code="at0077">
                <items id="text">Datum och tid för debut</items>
                <items id="description">Uppskattat eller reellt datum och tid när problemets eller diagnosens tecken eller symtom först observerades.</items>
                <items id="comment">Data som dokumenteras och importeras som "Ålder vid debut" ska konverteras till ett datum med hjälp av patientens födelsedatum.</items>
            </items>
            <items code="at0000">
                <items id="text">Problem/Diagnos</items>
                <items id="description">Detaljer av ett enskilt identifierat hälsotillstånd, skada, funktionshinder eller något annat problem som påverkar individens fysiska, psykiska och eller sociala välbefinnande.</items>
                <items id="comment">Det är inte lätt att i praktiken uppnå en tydlig avgränsning mellan ett problem och en diagnos. Vid tillämpning av klinisk dokumentation med denna arketyp betraktas problem och diagnos som ett kontinuum, med plats för fler detaljer och stödjande bevis som vanligtvis ger tyngd till etiketten ”diagnos”.</items>
            </items>
        </term_definitions>
        <term_definitions language="de">
            <items code="at0001">
                <items id="text">Structure</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0002">
                <items id="text">Name des Problems/ der Diagnose</items>
                <items id="description">Namentliche Identifikation des Problems oder der Diagnose.</items>
                <items id="comment">Wo möglich, ist die Kodierung des Problems oder der Diagnose über eine Terminologie zu bevorzugen.</items>
            </items>
            <items code="at0003">
                <items id="text">Datum/Zeitpunkt der klinischen Feststellung</items>
                <items id="description">Geschätzte oder exakte Zeit (bzw. Datum), zu der die Diagnose oder das Problem von einer medizinischen Fachkraft festgestellt wurde.</items>
                <items id="comment">Unvollständige Datumsangaben sind zulässig. Wenn der Patient unter einem Jahr alt ist, dann ist das vollständige Datum oder ein Minimum von Monat und Jahr notwendig, um genaue Altersberechnungen zu ermöglichen - z.B. wenn es zur Entscheidungsunterstützung verwendet wird. Datumswerte, die als "Alter zum Zeitpunkt der klinischen Feststellung" erfasst/importiert werden, sollten anhand des Geburtsdatums der Person in ein Datum umgewandelt werden.</items>
            </items>
            <items code="at0005">
                <items id="text">Schweregrad</items>
                <items id="description">Eine Gesamtbeurteilung des Schweregrades des Problems oder der Diagnose.</items>
                <items id="comment">Ist der Schweregrad über vordefinierte Codes im Element "Name des Problems/ der Diagnose" enthalten, wird dieses Datenelement überflüssig. Hinweis: Eine spezifischere Einstufung des Schweregrads kann mit Hilfe des SLOTs "Spezifische Angaben" angegeben werden.</items>
            </items>
            <items code="at0009">
                <items id="text">Klinische Beschreibung</items>
                <items id="description">Beschreibung des Problems oder der Diagnose.</items>
                <items id="comment">Wird verwendet, um Hintergrund und Kontext, einschließlich Entwicklung, Episoden oder Verschlechterungen, Fortschritt und andere relevante Details über das Problem oder die Diagnose zu liefern.</items>
            </items>
            <items code="at0012">
                <items id="text">Körperstelle</items>
                <items id="description">Identifikation einer einfachen Körperstelle zur Lokalisierung des Problems oder der Diagnose.</items>
                <items id="comment">Wo dies möglich ist, ist die Kodierung der anatomischen Lokalisation über eine Terminologie zu bevorzugen. Verwenden Sie dieses Datenelement, um vorab präkoordinierte anatomische Lokalisationen zu erfassen. Wenn die Anforderungen an die Erfassung der anatomischen Lokalisation zur Laufzeit durch die Anwendung bestimmt werden oder komplexere Modellierungen, wie z.B. relative Lokalisationen erforderlich sind, dann verwenden Sie in diesem Archetyp den CLUSTER.anatomical_location oder CLUSTER.relative_location innerhalb des SLOT 'Structured anatomical location'. Die Anzahl für dieses Datenelement ist unbegrenzt, um klinische Szenarien wie die Beschreibung eines Hautausschlags an mehreren Stellen zu ermöglichen, wobei jedoch alle anderen Attribute identisch sind. Falls die anatomische Lage über präkoordinierte Codes im Namen des Problems/Diagnose enthalten ist, wird dieses Datenelement überflüssig.</items>
            </items>
            <items code="at0030">
                <items id="text">Datum/Zeitpunkt der Genesung</items>
                <items id="description">Geschätzte oder exakte Zeit (bzw. Datum), zu der von einer medizinischen Fachkraft die Genesung oder die Remission des Problems oder der Diagnose festgestellt wurde.</items>
                <items id="comment">Unvollständige Datumsangaben sind zulässig. Wenn der Patient unter einem Jahr alt ist, dann ist das vollständige Datum oder ein Minimum von Monat und Jahr notwendig, um genaue Altersberechnungen zu ermöglichen - z.B. wenn es zur Entscheidungsunterstützung verwendet wird. Datumswerte, die als "Alter zum Zeitpunkt der Genesung" erfasst/importiert werden, sollten anhand des Geburtsdatums der Person in ein Datum umgewandelt werden.</items>
            </items>
            <items code="at0032">
                <items id="text">Tree</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0039">
                <items id="text">Anatomische Stelle (strukturiert)</items>
                <items id="description">Eine strukturierte anatomische Lokalisation des Problems oder der Diagnose.</items>
                <items id="comment">Verwenden Sie diesen SLOT, um die Archetypen CLUSTER.anatomical_location oder CLUSTER.relative_location einzufügen, wenn die Anforderungen für die Aufnahme der anatomischen Position zur Laufzeit der Anwendung bestimmt werden oder komplexere Modellierungen wie z.B. relative Positionen erforderlich sind. Ist die anatomische Lokalisation über präkoordinierte Codes im Namen des Problems/Diagnose enthalten, wird die Verwendung dieses SLOT überflüssig.</items>
            </items>
            <items code="at0043">
                <items id="text">Spezifische Angaben</items>
                <items id="description">Zusätzlich benötigte Angaben, welche als eindeutige Merkmale des Problem/der Diagnose erfasst werden sollten.</items>
                <items id="comment">Hier können strukturierte Angaben über die Einstufung oder das Stadium der Diagnose enthalten sein; diagnostische Kriterien, Klassifizierungskriterien oder formale Bewertungen des Schweregrades wie z.B. "Common Terminology Criteria for Adverse Events".</items>
            </items>
            <items code="at0046">
                <items id="text">Status</items>
                <items id="description">Strukturierte Angaben zu standort-, domänen-, episoden- oder workflow-spezifischen Aspekten des diagnostischen Prozesses.</items>
                <items id="comment">Verwenden Sie Status- oder Kontext-Merkmale mit Vorsicht, da sie in der Praxis variabel eingesetzt werden und die Interoperabilität nicht gewährleistet werden kann, sofern die Verwendung nicht mit der Nutzungsgemeinschaft klar abgestimmt wird. Beispiel: aktiver Status - aktiv, inaktiv, genesen, in Remission; Entwicklungsstatus - initial, interim/working, final; zeitlicher Status - aktuell, vergangen; Episodenstatus - erstmalig, neu, laufend; Aufnahmestatus - Aufnahme, Entlassung; oder Prioritätsstatus - primär, sekundär.</items>
            </items>
            <items code="at0047">
                <items id="text">Leicht</items>
                <items id="description">Das Problem oder die Diagnose beeinträchtigt die normale Aktivität nicht, bzw. verursacht nicht bleibende gesundheitliche Schäden, falls es nicht behandelt wird.</items>
            </items>
            <items code="at0048">
                <items id="text">Mäßig</items>
                <items id="description">Das Problem oder die Diagnose beeinträchtigt die normale Aktivität oder verursacht bleibende gesundheitliche Schäden, falls es nicht behandelt wird.</items>
            </items>
            <items code="at0049">
                <items id="text">Schwer</items>
                <items id="description">Das Problem oder die Diagnose verhindert die normale Aktivität oder verursacht schwerwiegende gesundheitliche Schäden, falls es nicht behandelt wird.</items>
            </items>
            <items code="at0069">
                <items id="text">Kommentar</items>
                <items id="description">Ergänzende Beschreibung des Problems oder der Diagnose, die nicht anderweitig erfasst wurde.</items>
            </items>
            <items code="at0070">
                <items id="text">Zuletzt aktualisiert</items>
                <items id="description">Datum der letzten Aktualisierung der Diagnose bzw. des Problems.</items>
            </items>
            <items code="at0071">
                <items id="text">Erweiterung</items>
                <items id="description">Zusätzliche Informationen zur Erfassung lokaler Inhalte oder Anpassung an andere Referenzmodelle/Formalismen.</items>
                <items id="comment">Zum Beispiel: Lokaler Informationsbedarf oder zusätzliche Metadaten zur Anpassung an FHIR-Ressourcen oder CIMI-Modelle.</items>
            </items>
            <items code="at0072">
                <items id="text">Beschreibung des Verlaufs</items>
                <items id="description">Beschreibung des Problem-/ Diagnoseverlaufs seit Beginn.</items>
            </items>
            <items code="at0073">
                <items id="text">Diagnostische Sicherheit</items>
                <items id="description">Grad der Sicherheit, mit der die Diagnose festgestellt wurde.</items>
            </items>
            <items code="at0074">
                <items id="text">Vermutet</items>
                <items id="description">Die Diagnose wurde mit einem niedrigen Grad an Sicherheit gestellt.</items>
            </items>
            <items code="at0075">
                <items id="text">Wahrscheinlich</items>
                <items id="description">Die Diagnose wurde mit einem hohen Maß an Sicherheit gestellt.</items>
            </items>
            <items code="at0076">
                <items id="text">Bestätigt</items>
                <items id="description">Die Diagnose wurde anhand anerkannter Kriterien bestätigt.</items>
            </items>
            <items code="at0077">
                <items id="text">Datum/ Zeitpunkt des Auftretens/ der Erstdiagnose</items>
                <items id="description">Geschätzte oder exakte Zeit (bzw. Datum), zu der die Krankheitsanzeichen oder Symptome zum ersten mal beobachtet wurden.</items>
                <items id="comment">Datumswerte, die als "Alter zu Beginn" erfasst/importiert werden, sollten anhand des Geburtsdatums der Person in ein Datum umgewandelt werden.</items>
            </items>
            <items code="at0000">
                <items id="text">Problem/Diagnose</items>
                <items id="description">Angaben über einen einzelnen identifizierten Gesundheitszustand, eine Verletzung, eine Behinderung oder ein Problem, welches das körperliche, geistige und/oder soziale Wohlergehen einer Einzelperson beeinträchtigt.</items>
                <items id="comment">Eine klare Abgrenzung zwischen Problem und Diagnose ist in der Praxis nicht einfach zu erreichen. Für die Zwecke der klinischen Dokumentation mit diesem Archetyp werden Problem und Diagnose als ein Kontinuum betrachtet, mit zunehmendem Detaillierungsgrad und unterstützenden Beweisen, die in der Regel dem Etikett "Diagnose" Gewicht verleihen.</items>
            </items>
        </term_definitions>
    </component_ontologies>
    <component_ontologies archetype_id="openEHR-EHR-SECTION.adhoc.v1">
        <term_definitions language="sv">
            <items code="at0000">
                <items id="text">Vitalparametrar</items>
                <items id="description">En allmän avsnittsrubrik som döps om i en openEHR-mall för att passa in i en specifik klinisk kontext.</items>
            </items>
        </term_definitions>
        <term_definitions language="de">
            <items code="at0000">
                <items id="text">Ad hoc Überschrift</items>
                <items id="description">Eine generische Abschnittsüberschrift eines Templates, welche entsprechend dem spezifischen klinischen Kontext umbenannt werden sollte.</items>
            </items>
        </term_definitions>
    </component_ontologies>
    <component_ontologies archetype_id="openEHR-EHR-OBSERVATION.respiration.v2">
        <term_definitions language="sv">
            <items code="at0001">
                <items id="text">Historik</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0002">
                <items id="text">Ospecificerad händelse</items>
                <items id="description">Ospecificerad standardhändelse vid en tidpunkt eller inom ett tidsintervall som explicit kan definieras i en mall eller genereras automatiskt av vissa IT-system.</items>
            </items>
            <items code="at0003">
                <items id="text">List</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0004">
                <items id="text">Frekvens</items>
                <items id="description">Spontanandningens frekvens.</items>
            </items>
            <items code="at0005">
                <items id="text">Regelbundenhet</items>
                <items id="description">Spontanandningens regelbundenhet.</items>
            </items>
            <items code="at0006">
                <items id="text">Regelbunden</items>
                <items id="description">Regelbunden andning.</items>
            </items>
            <items code="at0007">
                <items id="text">Oregelbunden</items>
                <items id="description">Oregelbunden andning.</items>
            </items>
            <items code="at0009">
                <items id="text">Klinisk tolkning</items>
                <items id="description">Ord, fras eller kort beskrivning som fångar den kliniska betydelsen hos andningsfynden.</items>
                <items id="comment">Kodning med en terminologi rekommenderas där så är möjligt. Exempelvis normal andning, tecken på ansträngd andning, Kussmauls andning, Cheyne-Stokes andning, återkommande apné. Flera val är tillåtet.</items>
            </items>
            <items code="at0016">
                <items id="text">Andningsdjup</items>
                <items id="description">Spontanandningens djup.</items>
            </items>
            <items code="at0017">
                <items id="text">Normal</items>
                <items id="description">Normalt andningsdjup.</items>
            </items>
            <items code="at0018">
                <items id="text">Ytlig</items>
                <items id="description">Ytligt andningsdjup.</items>
            </items>
            <items code="at0019">
                <items id="text">Djup</items>
                <items id="description">Djupandning.</items>
            </items>
            <items code="at0022">
                <items id="text">List</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0024">
                <items id="text">Klinisk beskrivning</items>
                <items id="description">Beskrivning av individens andningsdjup.</items>
                <items id="comment">Exempelvis plågad andning, andningsrörelse med hjälp av accessorisk muskel eller intermittent apné; suckar, grymtningar, jämmer, flämtningar. När en fullständig respiratorisk undersökning genomförs dokumenteras den lämpligen som en del av undersökningsfynden.</items>
            </items>
            <items code="at0025">
                <items id="text">Ojämn</items>
                <items id="description">Ojämnt andningsdjup.</items>
            </items>
            <items code="at0037">
                <items id="text">Ansträngning</items>
                <items id="description">Detaljer om den fysiska ansträngningen vid undersökningen.</items>
                <items id="comment">Individens ansträngningsnivå under eller strax innan observationen.</items>
            </items>
            <items code="at0055">
                <items id="text">Tillförd syrgas</items>
                <items id="description">Detaljer om mängden syrgas som tillförs individen vid observationstillfället.</items>
                <items id="comment">Värden som antas är syrekoncentration på 21%, Fi02 på 0.21 och flödeshastighet av syre på 0 l/min eller 0 ml/min.</items>
            </items>
            <items code="at0056">
                <items id="text">Möjliga felkällor</items>
                <items id="description">Beskrivning av faktorer och felkällor som kan påverka bedömningen av andningen.&#13;
</items>
                <items id="comment">Exempelvis ångestnivå, smärta, matning av spädbarn, trakeostomi.</items>
            </items>
            <items code="at0057">
                <items id="text">*Tree(en)</items>
                <items id="description">*@ internal @(en)</items>
            </items>
            <items code="at0058">
                <items id="text">Tilläggsinformation</items>
                <items id="description">Plats för att infoga tilläggsinformation som krävs för lokala anpassningar eller anpassning till andra referensmodeller eller formella krav.</items>
                <items id="comment">Exempelvis lokala informationskrav eller metadata för anpassning till FHIR.</items>
            </items>
            <items code="at0062">
                <items id="text">Förekomst</items>
                <items id="description">Observation av spontanandning.</items>
                <items id="comment">Det här fältet kan vara användbart i extrema situationer där formell mätning av andning ej är möjlig. Exempelvis om patienten är medvetslös och befinner sig på annan plats, såsom fast i en bil eller har fallit utför en klippa. Förekomst av andning kan antas om adningsfrekvensen är högre än 0 andetag per minut.</items>
            </items>
            <items code="at0063">
                <items id="text">Förekommer</items>
                <items id="description">Andningsrörelser observeras.</items>
            </items>
            <items code="at0064">
                <items id="text">Ej möjlig att upptäcka</items>
                <items id="description">Andningsrörelser kan inte upptäckas genom observation.</items>
            </items>
            <items code="at0065">
                <items id="text">Kroppsställning</items>
                <items id="description">Individens kroppsställning vid observationen.</items>
            </items>
            <items code="at0066">
                <items id="text">Stående</items>
                <items id="description">Individen stod, gick eller sprang.</items>
            </items>
            <items code="at0067">
                <items id="text">Sittande</items>
                <items id="description">Individen satt på exempelvis en säng eller en stol.</items>
            </items>
            <items code="at0068">
                <items id="text">Lutande</items>
                <items id="description">Individen lutade sig i ungefär 45 graders vinkel med benen i högläge i bäckennivå.</items>
            </items>
            <items code="at0069">
                <items id="text">Liggande</items>
                <items id="description">Individen låg på rygg.</items>
            </items>
            <items code="at0070">
                <items id="text">Kommentar</items>
                <items id="description">Kommentarer avseende andning som inte beskrivs i övriga fält.</items>
            </items>
            <items code="at0071">
                <items id="text">Magläge</items>
                <items id="description">Individen låg på mage.</items>
            </items>
            <items code="at0000">
                <items id="text">Andning</items>
                <items id="description">De observerade egenskaperna i spontanandning.</items>
            </items>
        </term_definitions>
        <term_definitions language="de">
            <items code="at0001">
                <items id="text">History</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0002">
                <items id="text">Beliebiges Ereignis</items>
                <items id="description">Standardmäßiger, nicht näher beschriebener Zeitpunkt oder Intervall Ereignis welches in einem Template oder bei der Anwendung genauer definiert werden kann.</items>
            </items>
            <items code="at0003">
                <items id="text">*List(en)</items>
                <items id="description">*@ internal @(en)</items>
            </items>
            <items code="at0004">
                <items id="text">Messwert</items>
                <items id="description">Die Frequenz der Spontanatmung.</items>
            </items>
            <items code="at0005">
                <items id="text">Regelmäßigkeit</items>
                <items id="description">Die Regelmäßigkeit der Spontanatmung.</items>
            </items>
            <items code="at0006">
                <items id="text">Regelmäßig</items>
                <items id="description">Die Atmungsweise ist regelmäßig.</items>
            </items>
            <items code="at0007">
                <items id="text">Unregelmäßig</items>
                <items id="description">Die Atmungsweise ist nicht regelmäßig.</items>
            </items>
            <items code="at0009">
                <items id="text">Klinische Auswertung</items>
                <items id="description">Einzelwort, Satz oder Kurzbeschreibung, die die klinische Bedeutung und den Stellenwert der Atmungsbefunde repräsentiert.</items>
                <items id="comment">Wenn möglich, wird eine Kodierung mit einer Terminologie bevorzugt. Zum Beispiel: Normale Atmung; Anzeichen von Atemnot; Kussmaul-Atmung; Cheyne-Stokes-Beatmung; oder Apnoe-Attacken. Mehrere Angaben sind möglich.</items>
            </items>
            <items code="at0016">
                <items id="text">Tiefe</items>
                <items id="description">Die Tiefe der Spontanatmung.</items>
            </items>
            <items code="at0017">
                <items id="text">Normal</items>
                <items id="description">Normale Atmungstiefe.</items>
            </items>
            <items code="at0018">
                <items id="text">Schwach</items>
                <items id="description">Schwache Atmungstiefe.</items>
            </items>
            <items code="at0019">
                <items id="text">Tief</items>
                <items id="description">Tiefes Einatmen.</items>
            </items>
            <items code="at0022">
                <items id="text">List</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0024">
                <items id="text">Klinische Beschreibung</items>
                <items id="description">Beschreibung der Spontanatmung der Person.</items>
                <items id="comment">Zum Beispiel: Beobachtung von Atemnot, Einsatz von Hilfsmuskeln oder Atemstillstand; Beobachtung von Charakteristiken wie Stridor, Seufzen, Grunzen, Stöhnen, Keuchen. &#13;
Wenn eine vollständige Untersuchung der Atemwege durchgeführt wurde, könnten einige dieser Befunde als Teil der Untersuchungsergebnisse besser erfasst werden.</items>
            </items>
            <items code="at0025">
                <items id="text">Veränderung</items>
                <items id="description">Unterschiedliche Atmungstiefe.</items>
            </items>
            <items code="at0037">
                <items id="text">Anwendung</items>
                <items id="description">Angaben über die körperliche Anstrengung, die während der Untersuchung unternommen wurde.</items>
                <items id="comment">Der Grad der Anstrengung der Person während oder kurz vor der Untersuchung.</items>
            </items>
            <items code="at0055">
                <items id="text">Inspirierter Sauerstoff</items>
                <items id="description">Angaben über die Sauerstoffmenge, die der Person zum Zeitpunkt der Beobachtung verabreicht wurde.</items>
                <items id="comment">Es werden Werte von 21% Sauerstoffkonzentration, Fi02 von 0,21 und eine Sauerstoffflussrate von 0 l/min oder 0 ml/min angenommen.</items>
            </items>
            <items code="at0056">
                <items id="text">Störfaktoren</items>
                <items id="description">Ermittlung von Aspekten oder zufälligen Faktoren, die sich auf die Auswertung der Beobachtung auswirkt.</items>
                <items id="comment">Zum Beispiel: Grad der Angst, Schmerzen, Ernährung bei Säuglingen, Luftröhrenschnitt (Tracheostomie).</items>
            </items>
            <items code="at0057">
                <items id="text">*Tree(en)</items>
                <items id="description">*@ internal @(en)</items>
            </items>
            <items code="at0058">
                <items id="text">Erweiterung</items>
                <items id="description">Zusätzliche Informationen, die zur Erfassung lokaler Inhalte oder zur Anpassung an andere Referenzmodelle/Formalismen erforderlich sind.</items>
                <items id="comment">Zum Beispiel: Lokale Informationsanforderungen oder zusätzliche Metadaten, um Verknüpfungen mit FHIR oder CIMI Äquivalenten herzustellen.</items>
            </items>
            <items code="at0062">
                <items id="text">Präsenz</items>
                <items id="description">Die Beobachtung der Spontanatmung.</items>
                <items id="comment">Dieses Datenelement kann in Grenzsituationen nützlich sein, in denen eine formale Messung der Atemfrequenz nicht möglich ist. Zum Beispiel: eine Person ist bewusstlos und weit entfernt vom Beobachter, wie z.B. in einem Auto eingeklemmt oder von einer Klippe gestürzt. Das Auftreten von Atmung kann impliziert werden, wenn die 'Rate' &gt;0 Atemzüge/min.</items>
            </items>
            <items code="at0063">
                <items id="text">Vorhanden</items>
                <items id="description">Es werden die Atmungsbewegungen beobachtet.</items>
            </items>
            <items code="at0064">
                <items id="text">Nicht nachgewiesen</items>
                <items id="description">Bei der Beobachtung werden keine Atembewegungen festgestellt.</items>
            </items>
            <items code="at0065">
                <items id="text">Körperposition</items>
                <items id="description">Die Körperposition der Person zum Zeitpunkt der Beobachtung.</items>
            </items>
            <items code="at0066">
                <items id="text">Stehend/aufrecht</items>
                <items id="description">Die Person stand, ging oder lief.</items>
            </items>
            <items code="at0067">
                <items id="text">Sitzend</items>
                <items id="description">Die Person saß (z.B. auf einem Bett oder Stuhl).</items>
            </items>
            <items code="at0068">
                <items id="text">Zurücklehnen</items>
                <items id="description">Die Person wurde in einem Winkel von ungefähr 45 Grad zurückgelehnt, wobei die Beine auf die Höhe des Beckens angehoben waren.</items>
            </items>
            <items code="at0069">
                <items id="text">Liegend</items>
                <items id="description">Die Person lag auf dem Rücken.</items>
            </items>
            <items code="at0070">
                <items id="text">Kommentar</items>
                <items id="description">Zusätzliche Beschreibung der Atmung, die in anderen Bereichen nicht erfasst wurde.</items>
            </items>
            <items code="at0071">
                <items id="text">Neigend</items>
                <items id="description">Die Person lag auf der Frontseite.</items>
            </items>
            <items code="at0000">
                <items id="text">Atemfrequenz</items>
                <items id="description">Die Charakteristiken der Spontanatmung einer Person.</items>
            </items>
        </term_definitions>
    </component_ontologies>
    <component_ontologies archetype_id="openEHR-EHR-OBSERVATION.pulse.v2">
        <term_definitions language="sv">
            <items code="at0001">
                <items id="text">structure</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0002">
                <items id="text">history</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0003">
                <items id="text">Ospecificerad händelse</items>
                <items id="description">Standardmässig ospecificerad tidpunkt eller tidsintervall som kan anges explicit i en mall, eller genereras automatiskt av vissa IT-system.</items>
            </items>
            <items code="at0004">
                <items id="text">Frekvens</items>
                <items id="description">Puls eller hjärtfrekvens, mätt i slag per minut.</items>
            </items>
            <items code="at0005">
                <items id="text">Regelbunden</items>
                <items id="description">Regelbunden puls eller regelbundna hjärtslag</items>
            </items>
            <items code="at0006">
                <items id="text">Regelbunden</items>
                <items id="description">Mönstret är regelbundet.</items>
            </items>
            <items code="at0007">
                <items id="text">Regelbundet oregelbunden</items>
                <items id="description">Mönstret är oregelbundet i ett regelbundet mönster, exempelvis ett överhoppat hjärtslag var N:te slag.</items>
            </items>
            <items code="at0008">
                <items id="text">Oregelbundet oregelbunden</items>
                <items id="description">Mönstret är oregelbundet på ett kaotiskt och oförutsägbart sätt, exempelvis förmaksflimmer.</items>
            </items>
            <items code="at0010">
                <items id="text">List</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0012">
                <items id="text">List</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0013">
                <items id="text">Kroppsställning</items>
                <items id="description">Patientens kroppsställning under observationen.</items>
            </items>
            <items code="at1000">
                <items id="text">Liggande</items>
                <items id="description">Patienten låg plant.</items>
            </items>
            <items code="at1001">
                <items id="text">Sittande</items>
                <items id="description">Patienten satt, exempelvis på en säng eller en stol.</items>
            </items>
            <items code="at1002">
                <items id="text">Halvliggande</items>
                <items id="description">Patienten låg i ungefär 45 graders vinkel, med benen upphöjda till bäckennivå.</items>
            </items>
            <items code="at1003">
                <items id="text">Stående eller upprätt</items>
                <items id="description">Patienten stod, gick eller sprang.</items>
            </items>
            <items code="at1005">
                <items id="text">Närvaro</items>
                <items id="description">Närvaro av puls eller hjärtslag.</items>
                <items id="comment">Puls eller hjärt</items>
            </items>
            <items code="at1013">
                <items id="text">Utrustning</items>
                <items id="description">Information om den utrustning som använts för att mäta puls eller hjärtfrekvens.</items>
            </items>
            <items code="at1017">
                <items id="text">Ansträngning</items>
                <items id="description">Uppgifter om fysisk ansträngning under undersökningen.</items>
            </items>
            <items code="at1018">
                <items id="text">Möjliga felkällor</items>
                <items id="description">Beskrivning av faktorer som kan påverka tolkningen av de fysiska fynden.</items>
                <items id="comment">Exempelvis pacemaker, ångestnivå, smärta eller feber.</items>
            </items>
            <items code="at1019">
                <items id="text">Metod</items>
                <items id="description">Metod som används för att observera pulsen eller hjärtslagen.</items>
                <items id="comment">Exempelvis stetoskop eller elektronisk övervakning.</items>
            </items>
            <items code="at1022">
                <items id="text">Klinisk beskrivning</items>
                <items id="description">Beskrivning av pulsen eller hjärtslagen.</items>
            </items>
            <items code="at1023">
                <items id="text">Klinisk tolkning</items>
                <items id="description">Enstaka ord, fras eller kort beskrivning om den kliniska innebörden och betydelsen av fynd från puls eller hjärtslag, inklusive rytm.</items>
                <items id="comment">Kodning med en terminologi är att föredra, om det är tillämpligt. Exempelvis bradykardi, prematura slag eller sinusrytm. Flera utlåtanden är tillåtna.</items>
            </items>
            <items code="at1024">
                <items id="text">Närvaro</items>
                <items id="description">Puls eller hjärtslag är identifierade.</items>
            </items>
            <items code="at1025">
                <items id="text">Frånvaro</items>
                <items id="description">Puls eller hjärtslag kan inte identifieras.</items>
            </items>
            <items code="at1028">
                <items id="text">Oregelbunden</items>
                <items id="description">Mönstret är oregelbundet.</items>
            </items>
            <items code="at1030">
                <items id="text">Karaktär</items>
                <items id="description">Beskrivning av pulsens eller hjärtslagets karaktär.</items>
                <items id="comment">Kodning med en terminologi är önskvärd, om det är tillämpligt. Exempelvis *full, trådfin, kraftig, långsamt stigande eller Corrigans puls.</items>
            </items>
            <items code="at1032">
                <items id="text">Palpation</items>
                <items id="description">Läkare eller sjuksköterska observerar fynden genom fysisk beröring av patienten.</items>
            </items>
            <items code="at1033">
                <items id="text">Auskultation</items>
                <items id="description">Fynden observeras med ett hjälpmedel, exempelvis ett stetoskop.</items>
            </items>
            <items code="at1034">
                <items id="text">Automatisk, icke-invasiv</items>
                <items id="description">Fynden observeras icke-invasivt med hjälp av utrustning såsom en pulsoximeter eller ett stetoskop.</items>
            </items>
            <items code="at1036">
                <items id="text">Maximum</items>
                <items id="description">Maxpuls eller maxfrekvens observerad under ansträngning.</items>
            </items>
            <items code="at1037">
                <items id="text">Lokalisation</items>
                <items id="description">Lokalisation där pulsen eller hjärtslagen observerades.</items>
            </items>
            <items code="at1038">
                <items id="text">Strålbensartär - Vänster</items>
                <items id="description">Vänster strålbensartär.</items>
            </items>
            <items code="at1039">
                <items id="text">Strålbensartär - Höger</items>
                <items id="description">Höger strålbensartär.</items>
            </items>
            <items code="at1040">
                <items id="text">Hjärt</items>
                <items id="description">Hjärttrakten.</items>
            </items>
            <items code="at1041">
                <items id="text">Halsartär - Vänster</items>
                <items id="description">Vänster halsartär.</items>
            </items>
            <items code="at1042">
                <items id="text">Halsartär - Höger</items>
                <items id="description">Höger halsartär.</items>
            </items>
            <items code="at1043">
                <items id="text">Lårbensartär - Vänster</items>
                <items id="description">Vänster lårbensartär.</items>
            </items>
            <items code="at1044">
                <items id="text">Lårbensartär- Höger</items>
                <items id="description">Höger lårbensartär.</items>
            </items>
            <items code="at1047">
                <items id="text">Finger</items>
                <items id="description">Ett ospecificerat finger.</items>
            </items>
            <items code="at1048">
                <items id="text">Armartär - Vänster</items>
                <items id="description">Vänster armartär.</items>
            </items>
            <items code="at1049">
                <items id="text">Armartär - Höger</items>
                <items id="description">Höger armartär.</items>
            </items>
            <items code="at1050">
                <items id="text">Automatisk, invasiv</items>
                <items id="description">Fynden observeras invasivt med hjälp av utrustning såsom en arteriell kateter.</items>
            </items>
            <items code="at1051">
                <items id="text">Örsnibb</items>
                <items id="description">En ospecificerad örsnibb.</items>
            </items>
            <items code="at1054">
                <items id="text">Tå</items>
                <items id="description">En ospecificerad tå.</items>
            </items>
            <items code="at1055">
                <items id="text">Oregelbunden typ</items>
                <items id="description">Ett mer specifikt mönster av oregelbunden puls eller oregelbundna hjärtslag.</items>
                <items id="comment">Ett val från den här värdemängden är endast giltigt om "oregelbunden" väljs från komponenten "regelbunden".</items>
            </items>
            <items code="at1056">
                <items id="text">Tilläggsinformation</items>
                <items id="description">Plats för att infoga tilläggsinformation som krävs för lokala anpassningar eller anpassning till andra referensmodeller eller formella krav.</items>
                <items id="comment">Exempelvis lokala informationskrav eller metadata för anpassning till FHIR- eller CIMI-motsvarigheter.</items>
            </items>
            <items code="at1057">
                <items id="text">Klinisk tolkning</items>
                <items id="description">Allmänt fält för ett enskilt eller samtliga utlåtanden om pulsen eller hjärtrytmen.</items>
            </items>
            <items code="at1058">
                <items id="text">Rytm</items>
                <items id="description">Specifik slutsats om pulsens eller hjärtslagens rytm, härledd från en kombination av hjärtfrekvens, mönster och andra egenskaper som observerats vid undersökningen.</items>
            </items>
            <items code="at1059">
                <items id="text">Kommentar</items>
                <items id="description">Ytterligare beskrivning av fynden från puls eller hjärtslag som inte beskrivits i andra fält.</items>
            </items>
            <items code="at0000">
                <items id="text">Puls/Hjärtfrekvens</items>
                <items id="description">Hjärtslagens eller pulsens frekvens och tillhörande attribut.</items>
            </items>
        </term_definitions>
        <term_definitions language="de">
            <items code="at0001">
                <items id="text">Structure</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0002">
                <items id="text">History</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0003">
                <items id="text">Jedes Ereignis</items>
                <items id="description">Ein Standardwert, ein spezifizierter Zeitpunkt oder ein Intervallereignis, welches explizit in einem Template oder während der Laufzeit definiert werden kann.</items>
            </items>
            <items code="at0004">
                <items id="text">Frequenz</items>
                <items id="description">Die Frequenz, gemessen in Schlägen pro Minute.</items>
            </items>
            <items code="at0005">
                <items id="text">Regelmäßigkeit</items>
                <items id="description">Regelmäßigkeit der Puls-/Herzfrequenz.</items>
            </items>
            <items code="at0006">
                <items id="text">Regelmäßig</items>
                <items id="description">Der Verlauf ist regelmäßig.</items>
            </items>
            <items code="at0007">
                <items id="text">Normal unregelmäßig</items>
                <items id="description">Der Verlauf ist unregelmäßig, aber in einem regelmäßigen Muster. Zum Beispiel das Ausfallen eines Schlages alle "n" Schläge.</items>
            </items>
            <items code="at0008">
                <items id="text">Ungleichmäßig unregelmäßig</items>
                <items id="description">Der Verlauf ist auf chaotische und unvorhersehbare Weise unregelmäßig. Zum Beispiel: Vorhofflimmern.</items>
            </items>
            <items code="at0010">
                <items id="text">List</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0012">
                <items id="text">List</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0013">
                <items id="text">Körperhaltung</items>
                <items id="description">Die Körperhaltung des Patienten während der Untersuchung.</items>
            </items>
            <items code="at1000">
                <items id="text">Liegend</items>
                <items id="description">Der Patient lag flach.</items>
            </items>
            <items code="at1001">
                <items id="text">Sitzend</items>
                <items id="description">Der Patient saß (zum Beispiel auf einem Bett oder einem Stuhl).</items>
            </items>
            <items code="at1002">
                <items id="text">Zurücklehnend</items>
                <items id="description">Der Patient saß zurück gelehnt in einem Winkel von 45 Grad und seine Beine waren bis zur Höhe des Beckens angehoben.</items>
            </items>
            <items code="at1003">
                <items id="text">Stehend/Aufrecht</items>
                <items id="description">Der Patient stand, ging oder rannte.</items>
            </items>
            <items code="at1005">
                <items id="text">Vorhandensein</items>
                <items id="description">Vorhandensein einer Puls- oder Herzfrequenz.</items>
                <items id="comment">Eine Puls-/Herzfrequenz ist vorhanden, wenn die Frequenz &gt; 0 Schläge pro Minute ist.</items>
            </items>
            <items code="at1013">
                <items id="text">Gerät</items>
                <items id="description">Informationen zu dem Gerät, welches zur Messung der Puls- oder der Herzfrequenz verwendet wurde.</items>
            </items>
            <items code="at1017">
                <items id="text">Anstrengung</items>
                <items id="description">Details über die körperliche Anstrengung, die der Patient während der Untersuchung ausgesetzt war.</items>
            </items>
            <items code="at1018">
                <items id="text">Störfaktoren</items>
                <items id="description">Die Beschreibung aller zufälligen Faktoren, die die Interpretation der physikalischen Ergebnisse beeinflussen können.</items>
                <items id="comment">Zum Beispiel das Vorhandensein eines Herzschrittmacher; das Angstniveau; Schmerzen oder Fieber etc.</items>
            </items>
            <items code="at1019">
                <items id="text">Methode</items>
                <items id="description">Die Methode, mit der die Puls- oder Herzfrequenz gemessen wurde.</items>
                <items id="comment">Zum Beispiel auskultatorisch oder über elektronisches Monitoring, z.B. mit einem Blutdruckmessgerät.</items>
            </items>
            <items code="at1022">
                <items id="text">Klinische Beschreibung</items>
                <items id="description">Beschreibung der Puls- oder Herzfrequenz.</items>
            </items>
            <items code="at1023">
                <items id="text">Klinische Interpretation</items>
                <items id="description">Ein einzelnes Wort, ein Satz oder eine kurze Beschreibung, welches die klinische Bedeutung und die Signifikanz der Puls- oder der Herzfrequenz, einschließlich des Rhythmus, darstellt.</items>
                <items id="comment">Die Kodierung mit einer Terminologie wird, wenn möglich, bevorzugt. Zum Beispiel: Bradykardie, Extrasystolen oder Sinusrhythmus. Mehrere Aussagen sind erlaubt.</items>
            </items>
            <items code="at1024">
                <items id="text">Vorhanden</items>
                <items id="description">Eine Puls- oder eine Herzfrequenz kann ermittelt werden.</items>
            </items>
            <items code="at1025">
                <items id="text">Nicht ermittelbar</items>
                <items id="description">Eine Puls- oder eine Herzfrequenz kann nicht ermittelt werden.</items>
            </items>
            <items code="at1028">
                <items id="text">Unregelmäßig</items>
                <items id="description">Der Verlauf ist unregelmäßig.</items>
            </items>
            <items code="at1030">
                <items id="text">Merkmal</items>
                <items id="description">Beschreibung des Merkmals der Puls- oder Herzfrequenz.</items>
                <items id="comment">Die Kodierung mit einer Terminologie ist, wenn möglich, erwünscht. Zum Beispiel: kräftig, schwach, hämmernd, langsam ansteigend oder kollabierend. Mehrere Begriffe können dokumentiert werden.</items>
            </items>
            <items code="at1032">
                <items id="text">Palpation</items>
                <items id="description">Der Befund wurde durch physisches Tasten des Beobachters am Patienten erlangt.</items>
            </items>
            <items code="at1033">
                <items id="text">Auskultation</items>
                <items id="description">Die Untersuchungsergebnisse werden mit Hilfe eines Gerätes, wie zum Beispiel einem Stethoskop, gemessen.</items>
            </items>
            <items code="at1034">
                <items id="text">Automatisch, nicht-invasiv</items>
                <items id="description">Die Untersuchungsergebnisse werden nicht-invasiv unter Anwendung eines Gerätes, wie zum Beispiel mit Hilfe eines Pulsoximeters oder eines Stethoskops, gemessen.</items>
            </items>
            <items code="at1036">
                <items id="text">Maximum</items>
                <items id="description">Die maximale Puls- oder Herzfrequenz, die während einer Belastungsperiode gemessen wurde.</items>
            </items>
            <items code="at1037">
                <items id="text">Körperstelle</items>
                <items id="description">Die Körperstelle an der die Puls- oder die Herzfrequenz gemessen wird.</items>
            </items>
            <items code="at1038">
                <items id="text">Arteria radialis - links</items>
                <items id="description">Die linke Arteria radialis.</items>
            </items>
            <items code="at1039">
                <items id="text">Arteria radialis - rechts</items>
                <items id="description">Die rechte Arteria radialis.</items>
            </items>
            <items code="at1040">
                <items id="text">Herz</items>
                <items id="description">Die Region des Herzens.</items>
            </items>
            <items code="at1041">
                <items id="text">Arteria carotis - links</items>
                <items id="description">Die linke Arteria carotis.</items>
            </items>
            <items code="at1042">
                <items id="text">Arteria carotis - rechts</items>
                <items id="description">Die rechte Arteria carotis.</items>
            </items>
            <items code="at1043">
                <items id="text">Arteria femoralis - links</items>
                <items id="description">Die linke Arteria femoralis.</items>
            </items>
            <items code="at1044">
                <items id="text">Arteria femoralis - rechts</items>
                <items id="description">Die rechts Arteria femoralis.</items>
            </items>
            <items code="at1047">
                <items id="text">Finger</items>
                <items id="description">Ein nicht näher beschriebener Finger.</items>
            </items>
            <items code="at1048">
                <items id="text">Arteria brachialis - links</items>
                <items id="description">Die linke Arteria brachialis.</items>
            </items>
            <items code="at1049">
                <items id="text">Arteria brachialis - rechts</items>
                <items id="description">Die rechte Arteria brachialis.</items>
            </items>
            <items code="at1050">
                <items id="text">Automatisch, invasiv</items>
                <items id="description">Die Untersuchungsergebnisse werden invasiv durch die Verwendung eines Gerätes, wie zum Beispiel eines arteriellen Katheters, gemessen.</items>
            </items>
            <items code="at1051">
                <items id="text">Ohrläppchen</items>
                <items id="description">Das Ohrläppchen eines unbestimmten Ohres.</items>
            </items>
            <items code="at1054">
                <items id="text">Zeh</items>
                <items id="description">Ein nicht näher beschriebener Zeh.</items>
            </items>
            <items code="at1055">
                <items id="text">Unregelmäßiger Typ</items>
                <items id="description">Ein spezifischeres Verlaufsmuster einer unregelmäßigen Puls- oder Herzfrequenz.</items>
                <items id="comment">Die Auswahl eines Wertes dieser Wertemenge ist nur valide, wenn "Unregelmäßig" vom Datenelement "Regelmäßigkeit" angegeben wurde.</items>
            </items>
            <items code="at1056">
                <items id="text">Erweiterung</items>
                <items id="description">Zusätzliche Informationen zur Erfassung lokaler Inhalte oder Anpassung an andere Referenzmodelle/Formalismen.</items>
                <items id="comment">Zum Beispiel: Lokaler Informationsbedarf oder zusätzliche Metadaten zur Anpassung an FHIR-Ressourcen oder CIMI-Modelle.</items>
            </items>
            <items code="at1057">
                <items id="text">Klinische Interpretation</items>
                <items id="description">Eine allgemeine Bezeichnung, um alle oder einen Teil der Aussagen über die Puls- oder die Herzfrequenz zu ermöglichen.</items>
            </items>
            <items code="at1058">
                <items id="text">Rhythmus</items>
                <items id="description">Spezifische Schlussfolgerung über den Rhythmus der Puls- oder der Herzfrequenz, die sich aus einer Kombination von Herzfrequenz, dem Verlaufsmuster und anderen bei der Untersuchung beobachteten Merkmalen ergibt.</items>
            </items>
            <items code="at1059">
                <items id="text">Kommentar</items>
                <items id="description">Zusätzliche Informationen über die Puls- oder die Herzfrequenz, die in anderen Bereichen nicht erfasst wurden.</items>
            </items>
            <items code="at0000">
                <items id="text">Pulsfrequenz/Herzfrequenz</items>
                <items id="description">Die Frequenz und zugehörige Attribute für die Puls- oder Herzfrequenz.</items>
            </items>
        </term_definitions>
    </component_ontologies>
    <component_ontologies archetype_id="openEHR-EHR-OBSERVATION.blood_pressure.v2">
        <term_definitions language="sv">
            <items code="at0001">
                <items id="text">Anamnes</items>
                <items id="description">Strukturnod anamnes.</items>
            </items>
            <items code="at0003">
                <items id="text">Tree</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0004">
                <items id="text">Systoliskt</items>
                <items id="description">Det högsta systemiskt arteriella blodtrycket uppmätt systoliskt eller under sammandragningsfasen av hjärtcykeln.</items>
            </items>
            <items code="at0005">
                <items id="text">Diastoliskt</items>
                <items id="description">Det minsta systemiskt arteriella blodtrycket uppmätt diastoliskt eller i hjärtcykelns avslappningsfas.</items>
            </items>
            <items code="at0006">
                <items id="text">Ospecificerad händelse</items>
                <items id="description">Standardval, händelse i ospecificerad tidpunkt eller tidsintervall som explicit kan definieras i en mall eller kan genereras automatiskt av vissa IT-system.</items>
            </items>
            <items code="at0007">
                <items id="text">Tree</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0008">
                <items id="text">Ställning</items>
                <items id="description">Individens kroppsställning under mätningen.</items>
            </items>
            <items code="at0011">
                <items id="text">Träd</items>
                <items id="description">Liststruktur</items>
            </items>
            <items code="at0013">
                <items id="text">Manschettstorlek</items>
                <items id="description">Storleken på manschetten som används för blodtrycksmätning.</items>
                <items id="comment">Perloff D, Grim C, Flack J, Frohlich ED, Hill M, McDonald M, Morgenstern BZ. Human blood pressure determination by sphygmomanometry. Circulation 1993;88;2460-2470.</items>
            </items>
            <items code="at0014">
                <items id="text">Mätplats</items>
                <items id="description">Beskrivning av anatomiskt plats där blodtrycket mäts.</items>
            </items>
            <items code="at0015">
                <items id="text">Vuxet lår</items>
                <items id="description">En lårmanschett för vuxna.</items>
            </items>
            <items code="at0016">
                <items id="text">Stor vuxen</items>
                <items id="description">En manschett för vuxna med större armar.</items>
            </items>
            <items code="at0017">
                <items id="text">Vuxen</items>
                <items id="description">En standardmanschett för vuxna.</items>
            </items>
            <items code="at0025">
                <items id="text">Höger arm</items>
                <items id="description">Individens högra arm.</items>
            </items>
            <items code="at0026">
                <items id="text">Vänster arm</items>
                <items id="description">Individens vänstra arm.</items>
            </items>
            <items code="at0027">
                <items id="text">Höger lår</items>
                <items id="description">Individens högra lår.</items>
            </items>
            <items code="at0028">
                <items id="text">Vänster lår</items>
                <items id="description">Individens vänstra lår.</items>
            </items>
            <items code="at0033">
                <items id="text">Kommentar</items>
                <items id="description">Ytterligare beskrivning av mätningen som inte beskrivits i andra fält.</items>
            </items>
            <items code="at1000">
                <items id="text">Stående</items>
                <items id="description">Stående ställning under blodtrycksmätningen</items>
            </items>
            <items code="at1001">
                <items id="text">Sittande</items>
                <items id="description">Sittande ställning under blodtrycksmätningen, exempelvis på en säng eller stol.</items>
            </items>
            <items code="at1002">
                <items id="text">Halvliggande</items>
                <items id="description">Halvliggande ställning under blodtrycksmätningen.</items>
            </items>
            <items code="at1003">
                <items id="text">Liggande</items>
                <items id="description">Liggande ställning under blodtrycksmätningen.</items>
            </items>
            <items code="at1005">
                <items id="text">Lutning</items>
                <items id="description">Lutning på ytan av huvuddelen som personen ligger på vid tidpunkten för mätningen.</items>
                <items id="comment">OBS: '°' är en giltig UCUM-enhet. Använd "deg" som den rätta enheten.</items>
            </items>
            <items code="at1006">
                <items id="text">Medelartärtryck</items>
                <items id="description">Det genomsnittliga artärtrycket som inträffar under hela hjärtsammandragningen och under avslappningscykeln.</items>
            </items>
            <items code="at1007">
                <items id="text">Pulstryck</items>
                <items id="description">Skillnaden mellan systoliskt och diastoliskt blodtryck.</items>
            </items>
            <items code="at1008">
                <items id="text">Liten Vuxen</items>
                <items id="description">En manschett som används till små vuxna.</items>
            </items>
            <items code="at1009">
                <items id="text">Pediatrisk/Barn</items>
                <items id="description">En manschett som passar barn eller vuxna med smala armar.</items>
            </items>
            <items code="at1010">
                <items id="text">Diastoliskt effektmått</items>
                <items id="description">Registrerat Korotkoff-ljud som används för att avgöra diastoliskt tryck med hjälp av auskultatorisk metod.</items>
            </items>
            <items code="at1011">
                <items id="text">Fas IV</items>
                <items id="description">Det fjärde Korotkoff-ljudet identifieras som en plötslig ljuddämpning.</items>
            </items>
            <items code="at1012">
                <items id="text">Fas V</items>
                <items id="description">Det femte Korotkoff-ljudet identifieras genom avsaknad av ljud då manschettrycket sjunker under det diastoliska blodtrycket.</items>
            </items>
            <items code="at1014">
                <items id="text">Liggande med lutning till vänster</items>
                <items id="description">Liggande i platt ställning med viss lateral lutning, vanligtvis mot vänster sida. Den krävs vanligtvis i graviditetens sista trimester för att lindra aortokaval kompression.</items>
            </items>
            <items code="at1018">
                <items id="text">Spädbarn</items>
                <items id="description">En manschett för spädbarn.</items>
            </items>
            <items code="at1019">
                <items id="text">Nyfödd</items>
                <items id="description">En manschett som används på nyfödda, om manschetten anses vara av lämplig storlek till den nyföddas mognads- och födelsevikt.</items>
            </items>
            <items code="at1020">
                <items id="text">Höger handled</items>
                <items id="description">Individens högra handled.</items>
            </items>
            <items code="at1021">
                <items id="text">Vänster handled</items>
                <items id="description">Individens vänstra handled.</items>
            </items>
            <items code="at1025">
                <items id="text">Utrustning</items>
                <items id="description">Detaljer om blodtrycksmätaren eller annan apparat som används för att mäta blodtrycket.</items>
            </items>
            <items code="at1026">
                <items id="text">Höger vrist</items>
                <items id="description">Individens högra vrist.</items>
            </items>
            <items code="at1030">
                <items id="text">Ansträngning</items>
                <items id="description">Detaljer om den fysiska aktiviteten som utförts vid tidpunkten av blodtrycksmätningen.</items>
            </items>
            <items code="at1031">
                <items id="text">Vänster vrist</items>
                <items id="description">Individens vänstra vrist.</items>
            </items>
            <items code="at1032">
                <items id="text">Finger</items>
                <items id="description">Individens finger.</items>
            </items>
            <items code="at1035">
                <items id="text">Metod</items>
                <items id="description">Metod för mätning av blodtryck.</items>
            </items>
            <items code="at1036">
                <items id="text">Auskultation</items>
                <items id="description">Metod för extern mätning av blodtryck med hjälp av stetoskop och Korotkoff-ljud.</items>
            </items>
            <items code="at1037">
                <items id="text">Palpation</items>
                <items id="description">Metod för att mäta blodtrycket externt med hjälp av palpation, vanligtvis av brakiala eller radiella artärer.</items>
            </items>
            <items code="at1038">
                <items id="text">Formel för medelartärtryck</items>
                <items id="description">Formel som används för att beräkna medelartärtrycket (om det finns registrerat).</items>
            </items>
            <items code="at1039">
                <items id="text">Blodtrycksmaskin</items>
                <items id="description">Metod för mätning av blodtryck externt med hjälp av en blodtrycksmaskin.</items>
            </items>
            <items code="at1040">
                <items id="text">Invasiv</items>
                <items id="description">Metod för att mäta blodtrycket intravenöst dvs. genom att penetrera huden och mäta inuti blodkärlen.</items>
            </items>
            <items code="at1042">
                <items id="text">24 timmars blodtrycksmätning</items>
                <items id="description">Beräkning av det genomsnittliga blodtrycket under en 24-timmarsperiod.</items>
            </items>
            <items code="at1043">
                <items id="text">Vakenhet</items>
                <items id="description">Vakenhet som stöder tolkningen av 24-timmars ambulatoriska blodtrycksmätningar.</items>
            </items>
            <items code="at1044">
                <items id="text">Alert och vaken</items>
                <items id="description">Patienten är vid fullt medvetande.</items>
            </items>
            <items code="at1045">
                <items id="text">Sover</items>
                <items id="description">Patienten är i det naturliga tillståndet av kroppslig vila.</items>
            </items>
            <items code="at1051">
                <items id="text">Tå</items>
                <items id="description">Individens tå.</items>
            </items>
            <items code="at1052">
                <items id="text">Möjliga felkällor</items>
                <items id="description">Andra faktorer som kan påverka blodtrycksmätningen, exempelvis ångestnivå, "vitrockseffekt", smärta, feber eller förändringar i lufttryck mm.</items>
            </items>
            <items code="at1053">
                <items id="text">Intraarteriell</items>
                <items id="description">Invasiv mätning via transduktoråtkomstlinjen inom en artär.</items>
            </items>
            <items code="at1054">
                <items id="text">Formel för systoliskt tryck</items>
                <items id="description">Formel som används för att beräkna det systoliska trycket från medelartärtrycket (om det finns registrerat).</items>
            </items>
            <items code="at1055">
                <items id="text">Formel för diastoliskt tryck</items>
                <items id="description">Formel som används för att beräkna det diastoliska trycket från medelartärtrycket (om det finns registrerat).</items>
            </items>
            <items code="at1056">
                <items id="text">Fotryggen</items>
                <items id="description">Individens fotrygg.</items>
            </items>
            <items code="at1057">
                <items id="text">Strukturerad mätplats</items>
                <items id="description">Strukturerad anatomisk plats där mätningen gjordes.</items>
            </items>
            <items code="at1058">
                <items id="text">Extra information</items>
                <items id="description">Ytterligare information som krävs för att fånga lokal kontext eller för anpassning till andra referensmodeller och formalismer.</items>
                <items id="comment">Exempelvis uppgifter om en lokal sjukhusavdelning eller ytterligare metadata för anpassning till FHIR- eller CIMI-motsvarigheter.</items>
            </items>
            <items code="at1059">
                <items id="text">Klinisk tolkning</items>
                <items id="description">Ord, fras eller kort beskrivning som representerar den kliniska betydelsen och signifikansen av blodtrycksmätningen.</items>
            </items>
            <items code="at0000">
                <items id="text">Blodtryck</items>
                <items id="description">Den lokala mätningen av artärblodtrycket som är ett substitut för artärtryck i den systemiska cirkulationen.</items>
                <items id="comment">Vanligtvis refererar användningen av termen blodtryck till mätningen av brakialartärtrycket i överarmen.</items>
            </items>
            <items code="mm[Hg]">
                <items id="text">mmHg</items>
                <items id="description">millimeters of mercury</items>
            </items>
        </term_definitions>
        <term_definitions language="de">
            <items code="at0001">
                <items id="text">Historie</items>
                <items id="description">Historie</items>
            </items>
            <items code="at0003">
                <items id="text">Blutdruck</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0004">
                <items id="text">Systolisch</items>
                <items id="description">Der höchste arterielle Blutdruck eines Zyklus - gemessen in der systolischen oder Kontraktionsphase des Herzens.</items>
            </items>
            <items code="at0005">
                <items id="text">Diastolisch</items>
                <items id="description">Der minimale systemische arterielle Blutdruck eines Zyklus - gemessen in der diastolischen oder Entspannungsphase des Herzens.</items>
            </items>
            <items code="at0006">
                <items id="text">Beliebiges Ereignis</items>
                <items id="description">Standardmäßiger, nicht näher beschriebener Zeitpunkt oder Intervall Ereignis welches in einem Template oder bei der Anwendung genauer definiert werden kann.</items>
            </items>
            <items code="at0007">
                <items id="text">state structure</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0008">
                <items id="text">Position</items>
                <items id="description">Die Position der untersuchten Person während der Messung.</items>
            </items>
            <items code="at0011">
                <items id="text">Listenstruktur</items>
                <items id="description">Listenstruktur</items>
            </items>
            <items code="at0013">
                <items id="text">Manschettengröße</items>
                <items id="description">Die Größe der Manschette, die zur Blutdruckmessung benutzt wurde.</items>
                <items id="comment">Perloff D, Grim C, Flack J, Frohlich ED, Hill M, McDonald M, Morgenstern BZ. Human blood pressure determination by sphygmomanometry. Circulation 1993;88;2460-2470.</items>
            </items>
            <items code="at0014">
                <items id="text">Stelle der Messung</items>
                <items id="description">Einfache Körperstelle an der der Blutdruck gemessen wurde.</items>
            </items>
            <items code="at0015">
                <items id="text">Oberschenkel eines Erwachsenen</items>
                <items id="description">Eine Manschette für den Oberschenkel eines Erwachsenen - ca. 20cm x 42cm.</items>
            </items>
            <items code="at0016">
                <items id="text">Großer Erwachsener</items>
                <items id="description">Eine Manschette für Erwachsene mit größeren Armen - ca. 16cm x 38cm.</items>
            </items>
            <items code="at0017">
                <items id="text">Erwachsener</items>
                <items id="description">Eine Standard-Manschette für einen Erwachsenen - ca. 13cm x 30cm.</items>
            </items>
            <items code="at0025">
                <items id="text">Rechter Arm</items>
                <items id="description">Der rechte Arm der Person.</items>
            </items>
            <items code="at0026">
                <items id="text">Linker Arm</items>
                <items id="description">Der linke Arm der Person.</items>
            </items>
            <items code="at0027">
                <items id="text">Rechter Oberschenkel</items>
                <items id="description">Der rechte Oberschenkel der Person.</items>
            </items>
            <items code="at0028">
                <items id="text">Linker Oberschenkel</items>
                <items id="description">Der linke Oberschenkel der Person.</items>
            </items>
            <items code="at0033">
                <items id="text">Kommentar</items>
                <items id="description">Zusätzlicher Freitext über die Messung, der nicht in anderen Felder erfasst werden konnte.</items>
            </items>
            <items code="at1000">
                <items id="text">Stehend</items>
                <items id="description">Stehend zum Zeitpunkt der Blutdruckmessung.</items>
            </items>
            <items code="at1001">
                <items id="text">Sitzend</items>
                <items id="description">Sitzend zum Zeitpunkt der Blutdruckmessung (z.B. auf einem Bett oder Stuhl).</items>
            </items>
            <items code="at1002">
                <items id="text">Zurückgelehnt</items>
                <items id="description">Patient zurückgelehnt zum Zeitpunkt der Blutdruckmessung.</items>
            </items>
            <items code="at1003">
                <items id="text">Liegend</items>
                <items id="description">Flach liegend zum Zeitpunkt der Blutdruckmessung.</items>
            </items>
            <items code="at1005">
                <items id="text">Neigung</items>
                <items id="description">Die kraniokaudale Neigung der Oberfläche auf der die Person zum Zeitpunkt der Messung liegt.</items>
            </items>
            <items code="at1006">
                <items id="text">Mittlerer arterieller Druck</items>
                <items id="description">Der mittlerer arterielle Druck über den gesamten Verlauf der Konktraktions- und Entspannungsphase des Herzens.</items>
            </items>
            <items code="at1007">
                <items id="text">Pulsdruck</items>
                <items id="description">Der Abstand zwischen dem systolischen und dem diastolischen Blutdruckwert.</items>
            </items>
            <items code="at1008">
                <items id="text">Kleiner Erwachsener</items>
                <items id="description">Eine Manschette für einen kleinen Erwachsenen - ca. 10cm x 24cm.</items>
            </items>
            <items code="at1009">
                <items id="text">Pädiatrisch/Kind</items>
                <items id="description">Eine Manschette für ein Kind oder auch einen Erwachsenen mit einem schmalen Arm - 8cm x 21cm.</items>
            </items>
            <items code="at1010">
                <items id="text">Diastolischer Endpunkt</items>
                <items id="description">Dient der Dokumentation des Korotkoff-Geräusches, das verwendet wird, um bei auskultarischer Messung den diastolischen Blutdruck zu bestimmen.</items>
            </items>
            <items code="at1011">
                <items id="text">Phase IV</items>
                <items id="description">Das 4. Korotkoff-Geräusch - Die Geräusche klingen plätzlich gedämpft.</items>
            </items>
            <items code="at1012">
                <items id="text">Phase V</items>
                <items id="description">Das 5. Korotkoff-Geräusch - die Geräusche verschwinden völlig während der Manschettendruck unter den diastolischen Blutdruck fällt.</items>
            </items>
            <items code="at1014">
                <items id="text">Nach links geneigt liegend</items>
                <items id="description">Flach liegend mit seitlicher Neigung, normalerweise zur linken Seite. Häufig verwendet im letzten Drittel eine Schwangerschaft, um aorto-cavale Kompression zu vermeiden.</items>
            </items>
            <items code="at1018">
                <items id="text">Kleinkind</items>
                <items id="description">Eine Manschette für Kleinkinder und Säuglinge - ca. 5cm x 15cm.</items>
            </items>
            <items code="at1019">
                <items id="text">Neonatal</items>
                <items id="description">Eine Manschette für Neugeborene mit passender Größe für die Reife und das Geburtsgewicht des Neugeborenen.</items>
            </items>
            <items code="at1020">
                <items id="text">Rechtes Handgelenk</items>
                <items id="description">Das rechte Handgelenk der Person.</items>
            </items>
            <items code="at1021">
                <items id="text">Linkes Handgelenk</items>
                <items id="description">Das linke Handgelenk der Person.</items>
            </items>
            <items code="at1025">
                <items id="text">Gerät</items>
                <items id="description">Details über das Sphygmomanometer oder ein anderes Gerät, dass zur Blutdruckmessung verwendet wird.</items>
            </items>
            <items code="at1026">
                <items id="text">Rechtes Fußgelenk</items>
                <items id="description">Das rechte Fußgelenk der Person.</items>
            </items>
            <items code="at1030">
                <items id="text">Anstrengung</items>
                <items id="description">Details über physische Aktivitäten zur Zeit der Blutdruckmessung.</items>
            </items>
            <items code="at1031">
                <items id="text">Linkes Fußgelenk</items>
                <items id="description">Das linke Fußgelenk der Person</items>
            </items>
            <items code="at1032">
                <items id="text">Finger</items>
                <items id="description">Ein Finger des Individuums.</items>
            </items>
            <items code="at1035">
                <items id="text">Methode</items>
                <items id="description">Methode der Messung des Blutdrucks.</items>
            </items>
            <items code="at1036">
                <items id="text">Auskultation</items>
                <items id="description">Auskulatorische Messung unter Benutzung eines Stethoskops und der Korotkoff-Geräusche.</items>
            </items>
            <items code="at1037">
                <items id="text">Palpation</items>
                <items id="description">Palpatorische Messung, normalerweise an den brachialen oder radialen Arterien.</items>
            </items>
            <items code="at1038">
                <items id="text">Formel für mittleren arterieller Druck</items>
                <items id="description">Die Formel die ggf. verwendet wurde, um den mittleren arteriellen Druck zu berechnen.</items>
            </items>
            <items code="at1039">
                <items id="text">Machine</items>
                <items id="description">Messung durch eine Blutdruckmaschine.</items>
            </items>
            <items code="at1040">
                <items id="text">Invasiv</items>
                <items id="description">Invasive Messung des Blutdrucks innerhalb eines Gefäßes.</items>
            </items>
            <items code="at1042">
                <items id="text">24 Stunden Durchschnitt</items>
                <items id="description">Schätzung des durchschnittlichen Blutdrucks über einen 24-stündigen Zeitraum.</items>
            </items>
            <items code="at1043">
                <items id="text">Schlafzustand</items>
                <items id="description">Schlafzustand - unterstützt die Auswertung von 24-stündigen ambulanten Aufzeichnungen des Blutdrucks.</items>
            </items>
            <items code="at1044">
                <items id="text">Aufmerksam und wach</items>
                <items id="description">Die untersuchte Person ist bei vollem Bewusstsein.</items>
            </items>
            <items code="at1045">
                <items id="text">Schlafend</items>
                <items id="description">Die untersuchte Person schläft.</items>
            </items>
            <items code="at1051">
                <items id="text">Zeh</items>
                <items id="description">Ein Zeh des Individuums.</items>
            </items>
            <items code="at1052">
                <items id="text">Einflussfaktoren</items>
                <items id="description">Kommentar und Aufzeichung anderer Faktoren die ggf. zu dem Ergebnis der Blutdruckmessung beitragen können. Die kann z.B. bei belastenden Situationen der Fall sein (z.B. sog. Weißkittelhypertonie, Schmerzen, Fieber, Änderungen im atmosphärischen Druck).</items>
            </items>
            <items code="at1053">
                <items id="text">Intraarteriell</items>
                <items id="description">Invasive Messung mittels Transducer über einen arteriellen Zugang.</items>
            </items>
            <items code="at1054">
                <items id="text">Formel für systolischen Druck</items>
                <items id="description">Formel, die benutzt wurde, um den systolischen Druck vom mittleren arteriellen Druck zu berechnen (wenn erfasst).</items>
            </items>
            <items code="at1055">
                <items id="text">Formel für diastolischen Druck</items>
                <items id="description">Formel, die benutzt wurde, um den distolischen Druck vom mittleren arteriellen Druck zu berechnen (wenn erfasst).</items>
            </items>
            <items code="at1056">
                <items id="text">Fußrücken</items>
                <items id="description">Fußrücken des Individuums.</items>
            </items>
            <items code="at1057">
                <items id="text">Strukturierte Stelle der Messung</items>
                <items id="description">Strukturierte Körperstelle an der der Blutdruck gemessen wurde.</items>
            </items>
            <items code="at1058">
                <items id="text">Erweiterung</items>
                <items id="description">Zusätzliche Information, die für die Erfassung des lokalen Kontexts oder für die Anpassung an andere Referenzmodelle/Formalismen benötigt wird.</items>
                <items id="comment">Zum Beispiel: Informationen bzgl. der lokalen Krankenhausabteilung oder zusätzliche Metadata zur Anpassung an entsprechende FHIR oder CIMI Gegenstücke.</items>
            </items>
            <items code="at1059">
                <items id="text">Klinische Interpretation</items>
                <items id="description">Einzelnes Wort, Ausdruck oder Kurzbeschreibung der klinischen Bedeutung und Aussagekraft der Blutdruckmessung.</items>
            </items>
            <items code="at0000">
                <items id="text">Blutdruck</items>
                <items id="description">Die lokale Messung des arteriellen Blutdrucks als Surrogat für den arteriellen Druck in der systemischen Zirkulation.</items>
                <items id="comment">Häufig wird der Ausdruck 'Blutdruck' zur Bezeichung der Messung des brachialen Ateriendrucks im Oberarm verwendet.</items>
            </items>
            <items code="mm[Hg]">
                <items id="text">mmHg</items>
                <items id="description">millimeters of mercury</items>
            </items>
        </term_definitions>
    </component_ontologies>
    <component_ontologies archetype_id="openEHR-EHR-OBSERVATION.body_temperature.v2">
        <term_definitions language="sv">
            <items code="at0001">
                <items id="text">Tree</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0002">
                <items id="text">History</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0003">
                <items id="text">Ospecificerad händelse</items>
                <items id="description">Ospecificerad standardhändelse vid en tidpunkt eller inom ett tidsintervall som explicit kan definieras i en mall eller genereras automatiskt av vissa IT-system.</items>
            </items>
            <items code="at0004">
                <items id="text">Temperatur</items>
                <items id="description">Den uppmätta temperaturen.</items>
            </items>
            <items code="at0020">
                <items id="text">Protocol</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0021">
                <items id="text">Mätplats</items>
                <items id="description">Kortfattad beskrivning av den anatomiska lokalisationen för mätningen.</items>
            </items>
            <items code="at0022">
                <items id="text">Mun</items>
                <items id="description">Temperaturmätning i munnen.</items>
            </items>
            <items code="at0023">
                <items id="text">Hörselgång</items>
                <items id="description">Temperaturmätning i yttre hörselgången.</items>
            </items>
            <items code="at0024">
                <items id="text">Axill</items>
                <items id="description">Temperaturmätning i armhålan, med armen placerad längs med sidan.</items>
            </items>
            <items code="at0025">
                <items id="text">Rektum</items>
                <items id="description">Temperaturmätning i ändtarmen.</items>
            </items>
            <items code="at0026">
                <items id="text">Nasofarynx</items>
                <items id="description">Temperaturmätning i bakre delen av näshålan.</items>
            </items>
            <items code="at0027">
                <items id="text">Urinblåsa</items>
                <items id="description">Temperaturmätning i urinblåsan.</items>
            </items>
            <items code="at0028">
                <items id="text">Intravaskulär</items>
                <items id="description">Temperaturmätning i kärlsystemet.</items>
            </items>
            <items code="at0029">
                <items id="text">Tillstånd</items>
                <items id="description">Information om patientens tillstånd.</items>
            </items>
            <items code="at0030">
                <items id="text">Kroppsexponering</items>
                <items id="description">Graden av exponering av individens kropp vid tidpunkten för mätningen.</items>
            </items>
            <items code="at0031">
                <items id="text">Naken</items>
                <items id="description">Inga kläder, sängkläder eller filtar.</items>
            </items>
            <items code="at0032">
                <items id="text">Minskad klädsel/sängkläder</items>
                <items id="description">Individen är täckt av mindre kläder eller sängkläder än vad som bedöms vara lämpligt med hänsyn till miljöförhållandena.</items>
            </items>
            <items code="at0033">
                <items id="text">Lämplig klädsel/sängkläder</items>
                <items id="description">Individen är täckt av den mängd kläder eller sängkläder som bedöms vara lämplig med hänsyn till miljöförhållanden.</items>
            </items>
            <items code="at0034">
                <items id="text">Ökad klädsel/sängkläder</items>
                <items id="description">Individen är täckt av mer kläder eller sängkläder än vad som bedöms vara lämpligt med hänsyn till miljöförhållanden.</items>
            </items>
            <items code="at0041">
                <items id="text">Beskrivning av termisk stress</items>
                <items id="description">Beskrivning av de möjliga faktorer som kan påverka individens uppmätta kroppstemperatur.</items>
            </items>
            <items code="at0043">
                <items id="text">Hud</items>
                <items id="description">Temperaturmätning på exponerad hud.</items>
            </items>
            <items code="at0051">
                <items id="text">Vagina</items>
                <items id="description">Temperaturmätning i vagina.</items>
            </items>
            <items code="at0054">
                <items id="text">Esofagus</items>
                <items id="description">Temperaturmätning i matstrupen.</items>
            </items>
            <items code="at0055">
                <items id="text">Ljumskveck</items>
                <items id="description">Temperaturmätning i ljumskens hudveck mellan benet och bukväggen.</items>
            </items>
            <items code="at0056">
                <items id="text">Miljöförhållanden</items>
                <items id="description">Detaljer om miljöförhållanden vid tidpunkten för temperaturmätningen.</items>
            </items>
            <items code="at0057">
                <items id="text">Ansträngningsgrad</items>
                <items id="description">Uppgifter om individens fysiska ansträngningsgrad vid tidpunkten för temperaturmätningen.</items>
            </items>
            <items code="at0059">
                <items id="text">Utrustning</items>
                <items id="description">Beskrivning av den utrustning som används för att mäta kroppstemperaturen.</items>
            </items>
            <items code="at0060">
                <items id="text">Tinning</items>
                <items id="description">Temperaturmätning vid tinningen, över den ytliga tinningartären.</items>
            </items>
            <items code="at0061">
                <items id="text">Panna</items>
                <items id="description">Temperaturmätning på pannan.</items>
            </items>
            <items code="at0062">
                <items id="text">Tilläggsinformation</items>
                <items id="description">Plats för tilläggsinformation som krävs för lokala anpassningar eller anpassning till andra referensmodeller eller formella krav.</items>
                <items id="comment">Exempelvis lokala informationskrav eller metadata för anpassning till FHIR-motsvarigheter.</items>
            </items>
            <items code="at0063">
                <items id="text">Kommentar</items>
                <items id="description">Kommentarer avseende mätningen av kroppstemperaturen som inte beskrivs i övriga datafält.</items>
            </items>
            <items code="at0064">
                <items id="text">Strukturerad mätplats</items>
                <items id="description">Strukturerad beskrivning av den anatomiska lokalisationen för mätningen.</items>
            </items>
            <items code="at0065">
                <items id="text">Dag i menstruationscykeln</items>
                <items id="description">Nuvarande dag i menstruationscykeln.</items>
                <items id="comment">Den första dagen av menstruationen anses vara dag 1 i menstruationscykeln.</items>
            </items>
            <items code="at0066">
                <items id="text">Möjliga felkällor</items>
                <items id="description">Beskrivning av faktorer och felkällor som kan påverka bedömningen av mätningen av kroppstemperaturen och som inte beskrivs i övriga datafält.</items>
            </items>
            <items code="at0000">
                <items id="text">Kroppstemperatur</items>
                <items id="description">En registrering av kroppstemperaturen hos en individ som ett indirekt mått på kroppens kärntemperatur.</items>
            </items>
            <items code="Cel">
                <items id="text">°C</items>
                <items id="description">degrees Celsius</items>
            </items>
            <items code="[degF]">
                <items id="text">°F</items>
                <items id="description">degrees Fahrenheit</items>
            </items>
        </term_definitions>
        <term_definitions language="de">
            <items code="at0001">
                <items id="text">Single</items>
                <items id="description">*</items>
            </items>
            <items code="at0002">
                <items id="text">History</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0003">
                <items id="text">Beliebiges Ereignis</items>
                <items id="description">Standardwert, ein undefinierter/s Zeitpunkt oder Intervallereignis, das explizit im Template oder zur Laufzeit der Anwendung definiert werden kann.</items>
            </items>
            <items code="at0004">
                <items id="text">Temperatur</items>
                <items id="description">Die gemessene Körpertemperatur.</items>
            </items>
            <items code="at0020">
                <items id="text">Protocol</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0021">
                <items id="text">Lokalisation der Messung</items>
                <items id="description">Einfache Beschreibung der Stelle der Messung.</items>
            </items>
            <items code="at0022">
                <items id="text">Mund</items>
                <items id="description">Messung der Temperatur im Mund.</items>
            </items>
            <items code="at0023">
                <items id="text">Ohrkanal</items>
                <items id="description">Messung der Temperatur innerhalb des äußeren Gehörgangs.</items>
            </items>
            <items code="at0024">
                <items id="text">Achselhöhle</items>
                <items id="description">Messung der Temperatur an der Haut der Achselhöhle mit seitlich angelegtem Arm.</items>
            </items>
            <items code="at0025">
                <items id="text">Rektum</items>
                <items id="description">Messung der Temperatur innerhalb des Rektums.</items>
            </items>
            <items code="at0026">
                <items id="text">Nasopharynx</items>
                <items id="description">Messung der Temperatur innerhalb des Nasopharynxs (Nasenrachens).</items>
            </items>
            <items code="at0027">
                <items id="text">Harnblase</items>
                <items id="description">Messung der Temperatur in der Harnblase.</items>
            </items>
            <items code="at0028">
                <items id="text">Intravaskulär</items>
                <items id="description">Messung der Temperatur innerhalb des vaskulären Systems.</items>
            </items>
            <items code="at0029">
                <items id="text">Status</items>
                <items id="description">Statusinformationen über den Patienten.</items>
            </items>
            <items code="at0030">
                <items id="text">Körperexposition</items>
                <items id="description">Der Expositionsgrad der Person, deren Temperatur gemessen wird.</items>
            </items>
            <items code="at0031">
                <items id="text">Nackt</items>
                <items id="description">Keine Kleidung, Bettzeug oder andere Bedeckung.</items>
            </items>
            <items code="at0032">
                <items id="text">Reduzierte Kleidung/Bettzeug</items>
                <items id="description">Die Person wird bedeckt von einer geringeren Menge an Kleidung oder Bettzeug als für die Umgebungsbedingungen angemessen erscheint.</items>
            </items>
            <items code="at0033">
                <items id="text">Angemessene Kleidung/Bettzeug</items>
                <items id="description">Die Person wird bedeckt von einer Menge an Kleidung oder Bettzeug, die den Umgebungsbedingungen angemessen erscheint.</items>
            </items>
            <items code="at0034">
                <items id="text">Erhöhte Kleidung/Bettzeug</items>
                <items id="description">Die Person wird bedeckt von einer größeren Menge an Kleidung oder Bettzeug als für die Umgebungsbedingungen angemessen erscheint.</items>
            </items>
            <items code="at0041">
                <items id="text">Beschreibung der Wärmebelastung</items>
                <items id="description">Beschreibung von Bedingungen, denen die Person ausgesetzt ist, welche die gemessene Körpertemperatur beeinflussen könnten.</items>
            </items>
            <items code="at0043">
                <items id="text">Haut</items>
                <items id="description">Messung der Temperatur an freiliegender Haut.</items>
            </items>
            <items code="at0051">
                <items id="text">Vagina</items>
                <items id="description">Messung der Temperatur innerhalb der Vagina.</items>
            </items>
            <items code="at0054">
                <items id="text">Oesophagus</items>
                <items id="description">Messung der Temperatur innerhalb des Oesophagus.</items>
            </items>
            <items code="at0055">
                <items id="text">Inguinale Hautfalte</items>
                <items id="description">Messung der Temperatur in der inguinalen Hautfalte zwischen Bein und Abdominalwand.</items>
            </items>
            <items code="at0056">
                <items id="text">Umgebungsbedingungen</items>
                <items id="description">Details über die Umgebungsbedingungen zum Zeitpunkt der Temperaturmessung</items>
            </items>
            <items code="at0057">
                <items id="text">Betätigung</items>
                <items id="description">Details über die Betätigung der Person zum Zeitpunkt der Messung der Temperatur.</items>
            </items>
            <items code="at0059">
                <items id="text">Gerät</items>
                <items id="description">Details über das Gerät, das zur Temperaturmessung benutzt wurde.</items>
            </items>
            <items code="at0060">
                <items id="text">Schläfe</items>
                <items id="description">Messung der Temperatur an der Schläfe, über der oberflächlichen Schläfenarterie.</items>
            </items>
            <items code="at0061">
                <items id="text">Stirn</items>
                <items id="description">Messung der Temperatur auf der Stirn.</items>
            </items>
            <items code="at0062">
                <items id="text">Erweiterung</items>
                <items id="description">Zusätzliche Informationen zur Erfassung lokaler Inhalte oder Anpassung an andere Referenzmodelle/Formalismen.</items>
                <items id="comment">Zum Beispiel: Lokaler Informationsbedarf oder zusätzliche Metadaten zur Anpassung an FHIR-Ressourcen.</items>
            </items>
            <items code="at0063">
                <items id="text">Kommentar</items>
                <items id="description">Zusätzliche Informationen über die Körpertemperatur, die nicht in anderen Bereichen dargestellt wurden.</items>
            </items>
            <items code="at0064">
                <items id="text">Strukturierte Lokalisation der Messung</items>
                <items id="description">Strukturierte anatomische Lokalisation, an dem die Messung vorgenommen wurde.</items>
            </items>
            <items code="at0065">
                <items id="text">Tag des Menstruationszyklus</items>
                <items id="description">Aktueller Tag des Menstruationszyklus.</items>
                <items id="comment">Der erste Tag der Menstruation gilt als Tag 1 jedes Menstruationszyklus.</items>
            </items>
            <items code="at0066">
                <items id="text">Störfaktoren</items>
                <items id="description">Zusätzliche Probleme oder Faktoren, die sich auf die Messung der Körpertemperatur auswirken können und in anderen Bereichen nicht dargestellt werden.</items>
            </items>
            <items code="at0000">
                <items id="text">Körpertemperatur</items>
                <items id="description">Eine Messung der Körpertemperatur, als Surrogat für die Temperatur des gesamten Körper der Person.</items>
            </items>
            <items code="Cel">
                <items id="text">°C</items>
                <items id="description">degrees Celsius</items>
            </items>
            <items code="[degF]">
                <items id="text">°F</items>
                <items id="description">degrees Fahrenheit</items>
            </items>
        </term_definitions>
    </component_ontologies>
    <component_ontologies archetype_id="openEHR-EHR-OBSERVATION.pulse_oximetry.v1">
        <term_definitions language="sv">
            <items code="at0001">
                <items id="text">Händelseförlopp</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0002">
                <items id="text">Ospecificerad händelse</items>
                <items id="description">Ospecificerad händelse&#13;
&#13;
Ospecificerad standardhändelse vid en tidpunkt eller inom ett tidsintervall som explicit kan definieras i en mall eller genereras automatiskt av vissa IT-system.</items>
            </items>
            <items code="at0003">
                <items id="text">Tree</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0006">
                <items id="text">SpO₂</items>
                <items id="description">Syremättnad i perifert blod uppmätt genom pulsoximetri.</items>
                <items id="comment">SpO₂ defineras som procentandelen oxyhemoglobin (HbO₂) i förhållande till totala koncentrationen av hemoglobin (HbO₂ + deoxyhemoglobin) i perifert blod.</items>
            </items>
            <items code="at0007">
                <items id="text">List</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0009">
                <items id="text">Mätplats</items>
                <items id="description">Plats på kroppen där sensorn satt under mätningen</items>
                <items id="comment">Exempelvis: höger pekfinger, vänster örsnibb.&#13;
Bör kodas med terminologi om möjligt</items>
            </items>
            <items code="at0014">
                <items id="text">Tree</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0015">
                <items id="text">Tillförd syrgas</items>
                <items id="description">Detaljer om mängden syre som patienten inandas vid observationstillfället.&#13;
</items>
                <items id="comment">Antagna värden på 21% syrekoncentration, Fi02 på 0,21 och tillfört extra syrgasflöde 0 l/min eller 0 ml/min.</items>
            </items>
            <items code="at0016">
                <items id="text">Möjliga felkällor</items>
                <items id="description">Beskrivning av faktorer och felkällor som kan påverka bedömningen av mätningen.</items>
                <items id="comment">Exempelvis rörelse, smärta, dålig perfusion, spädbarn som ammar, perifer hypotermi, bedövning etc.</items>
            </items>
            <items code="at0018">
                <items id="text">Oximetriutrustning</items>
                <items id="description">Detaljer om den icke-invasiva oximetriutrustningen som användes.</items>
            </items>
            <items code="at0034">
                <items id="text">Ansträngning</items>
                <items id="description">Detaljer om fysisk aktivitet vid mätningstillfället.</items>
            </items>
            <items code="at0036">
                <items id="text">Kommentar</items>
                <items id="description">Kommentar angående pulsoximetriresultatet</items>
            </items>
            <items code="at0044">
                <items id="text">SpOC</items>
                <items id="description">Syreinehållet i preifert blod, beräknat från pulsoximetri och puls-CO-oximetri i kombination.</items>
            </items>
            <items code="at0045">
                <items id="text">SpCO</items>
                <items id="description">Mättnaden av karboxihemoglobin i perifert blod, mätt genom puls CO-oximetri.</items>
            </items>
            <items code="at0046">
                <items id="text">SpMet</items>
                <items id="description">Mättnaden av metahemoglobin i perifert blod uppmätt genom puls-CO-oximetri.</items>
            </items>
            <items code="at0054">
                <items id="text">Vågform</items>
                <items id="description">Vågform kopplad till oximetrimätningen.</items>
            </items>
            <items code="at0058">
                <items id="text">Tolkning</items>
                <items id="description">Ord, fras eller kort text som beskriver den kliniska innebörden och signifikansen av mätningarna.</items>
                <items id="comment">Bör kodas med terminologi om möjligt, t.ex. kodade termer för "normal syremättnad" eller "hypoxi"</items>
            </items>
            <items code="at0059">
                <items id="text">Tilläggsinformation</items>
                <items id="description">Plats för att infoga tilläggsinformation som krävs för lokala anpassningar eller anpassning till andra referensmodeller eller formella krav.</items>
                <items id="comment">Exempelvis lokala informationskrav eller metadata för anpassning till HL7 eller CDISC-motsvarigheter.</items>
            </items>
            <items code="at0060">
                <items id="text">Multimedia-bild(er)</items>
                <items id="description">Detaljer för en serie oximetrimätningar, utöver vågformer, representerade som en bild eller bildserie. Rena vågformer skall istället lagras i fältet "Vågform" och tillhörande CLUSTER-arketyp.</items>
            </items>
            <items code="at0061">
                <items id="text">Pre/post-duktal</items>
                <items id="description">Mätsensorns placering i relation till ductus arteriosus hos nyfödda &#13;
barn, för att avgöra om blodtillförseln till kroppsdelen sensorn sitter på är pre- eller post-duktal för patienter med öppetstående ductus arteriosus.</items>
            </items>
            <items code="at0062">
                <items id="text">Preduktal</items>
                <items id="description">Sensorn är placerad preduktalt.</items>
            </items>
            <items code="at0063">
                <items id="text">Postduktal</items>
                <items id="description">Sensorn är placerad postduktalt.</items>
            </items>
            <items code="at0064">
                <items id="text">Obestämd</items>
                <items id="description">Det går inte att bedöma om sensorplatsen är pre- eller post-duktal</items>
            </items>
            <items code="at0000">
                <items id="text">Pulsoximetri</items>
                <items id="description">Syremättnad i blodet och relaterade mätningar, uppmätta med pulsoximetri eller CO-oximetri.</items>
            </items>
        </term_definitions>
        <term_definitions language="de">
            <items code="at0001">
                <items id="text">Event Series</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0002">
                <items id="text">Beliebiges Ereignis</items>
                <items id="description">Standardwert, ein undefinierter/s Zeitpunkt oder Intervallereignis, das explizit im Template oder zur Laufzeit der Anwendung definiert werden kann.</items>
            </items>
            <items code="at0003">
                <items id="text">Baum</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0006">
                <items id="text">SpO₂</items>
                <items id="description">Die Sättigung des Sauerstoffs im peripheren Blut, mittels Pulsoxymetrie gemessen.</items>
                <items id="comment">SpO₂ ist definiert als der prozentuale Anteil von Oxyhämoglobin (HbO₂) an der Gesamtkonzentration von Hämoglobin (HbO₂ + Deoxyhämoglobin) im peripheren Blut.</items>
            </items>
            <items code="at0007">
                <items id="text">Liste</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0009">
                <items id="text">Sensor Stelle</items>
                <items id="description">Die Stelle des Messsensors.</items>
                <items id="comment">Zum Beispiel: Rechter Zeigefinger, linkes Ohrläppchen. Eine Kodierung mit einer Terminologie wird, wenn möglich, bevorzugt.</items>
            </items>
            <items code="at0014">
                <items id="text">*Tree(en)</items>
                <items id="description">*@ internal @(en)</items>
            </items>
            <items code="at0015">
                <items id="text">Eingeatmeter Sauerstoff</items>
                <items id="description">Details über die Sauerstoffmenge, die dem Probanden zum Zeitpunkt der Beobachtung zur Verfügung steht.</items>
                <items id="comment">Angenommene Werte von 21% Sauerstoffkonzentration, Fi0₂ von 0,21 und Sauerstoffdurchflussrate von 0 l/min oder 0 ml/min.</items>
            </items>
            <items code="at0016">
                <items id="text">Einflussfaktoren</items>
                <items id="description">Kommentar und Aufzeichung anderer Faktoren die ggf. die Interpretation der Beobachtung beeinflussen können&#13;
&#13;
</items>
                <items id="comment">Zum Beispiel Bewegung, Schmerzen, schlechte Durchblutung, Säuglingsernährung, periphere Unterkühlung, Sedierung.&#13;
</items>
            </items>
            <items code="at0018">
                <items id="text">Oxymetrie Gerät</items>
                <items id="description">Details über das verwendeten nicht-invasiven Oximetriegeräte.</items>
            </items>
            <items code="at0034">
                <items id="text">Anstrengung</items>
                <items id="description">Details über physische Aktivitäten zur Zeit der Messung.</items>
            </items>
            <items code="at0036">
                <items id="text">Kommentar</items>
                <items id="description">Ein Kommentar über das Ergebnis der Pulsoximetrie.</items>
            </items>
            <items code="at0044">
                <items id="text">SpOC</items>
                <items id="description">Der Sauerstoffgehalt des peripheren Blutes, auf der Grundlage der Pulsoxymetrie und der Puls-CO-Oximetrie berechnet.</items>
            </items>
            <items code="at0045">
                <items id="text">SpCO</items>
                <items id="description">Die Sättigung des Carboxyhämoglobins im peripheren Blut, mittels Puls-CO-Oximetrie gemessen.</items>
            </items>
            <items code="at0046">
                <items id="text">SpMet</items>
                <items id="description">Die Sättigung des Methämoglobins im peripheren Blut, mittels Puls-CO-Oximetrie gemessen.</items>
            </items>
            <items code="at0054">
                <items id="text">Wellenform</items>
                <items id="description">Eine mittels Oximetermessung verbundene Wellenformmessung.</items>
            </items>
            <items code="at0058">
                <items id="text">Interpretation</items>
                <items id="description">Ein einzelnes Wort, eine Phrase oder eine kurze Beschreibung, welches die klinische Bedeutung und Signifikanz der Messung darstellt.</items>
                <items id="comment">Eine Kodierung mit einer Terminologie wird, wenn möglich, bevorzugt. Zum Beispiel: normale Sauerstoffsättigung oder Hypoxämie.</items>
            </items>
            <items code="at0059">
                <items id="text">Erweiterung</items>
                <items id="description">Zusätzliche Information, die für die Erfassung des lokalen Kontexts oder für die Anpassung an andere Referenzmodelle/Formalismen benötigt wird.&#13;
</items>
                <items id="comment">Zum Beispiel: Informationen bzgl. der lokalen Krankenhausabteilung oder zusätzliche Metadata zur Anpassung an entsprechende FHIR oder CIMI Gegenstücke.</items>
            </items>
            <items code="at0060">
                <items id="text">Multimedia-Bild</items>
                <items id="description">Details einer Reihe von Oximetrie-Messwerten, die keine Wellenformen sind, ausgedrückt als Multimediabild oder Bilderserie. Wellenformen sollten unter der Verwendung des Wellenform Slots und des zugehörigen Cluster-Archetyps dargestellt werden.</items>
            </items>
            <items code="at0061">
                <items id="text">prä/postduktal</items>
                <items id="description">Stelle des Sensors bezogen zum Ductus arteriosus bei Neugeborenen, um zu bestimmen, ob die Blutversorgung der Extremität der Sensorstelle prä- oder postduktal ist, wenn es sich um einen patentierten Ductus arteriosus handelt.&#13;
</items>
            </items>
            <items code="at0062">
                <items id="text">Präduktal</items>
                <items id="description">Die Senorstelle ist präduktal.</items>
            </items>
            <items code="at0063">
                <items id="text">Postductal</items>
                <items id="description">Die Senorstelle ist postductal.</items>
            </items>
            <items code="at0064">
                <items id="text">Unbestimmt</items>
                <items id="description">Kann nicht beurteilen, ob die Sensorstelle prä- oder postductal ist.</items>
            </items>
            <items code="at0000">
                <items id="text">Pulsoxymetrie</items>
                <items id="description">Blutsauerstoff und verwandte Messungen, die mittels Pulsoxymetrie oder Puls-CO-Oximetrie gemessen wurden.</items>
            </items>
        </term_definitions>
    </component_ontologies>
    <component_ontologies archetype_id="openEHR-EHR-CLUSTER.inspired_oxygen.v1">
        <term_definitions language="sv">
            <items code="at0051">
                <items id="text">Syrgasflöde</items>
                <items id="description">Syrgasflöde (flödeshastighet) som ges till en individ.</items>
                <items id="comment">Exempelvis "5 l/min"</items>
            </items>
            <items code="at0052">
                <items id="text">FiO₂</items>
                <items id="description">Andel syre i inandningsluften.</items>
                <items id="comment">Exempelvis "0.28"</items>
            </items>
            <items code="at0053">
                <items id="text">Procent O₂</items>
                <items id="description">Procentandel syre i inandningsluften.</items>
                <items id="comment">Exempelvis "24%"</items>
            </items>
            <items code="at0054">
                <items id="text">Administrationssätt för syrgas</items>
                <items id="description">Metoden för att ge (administrera) syrgasen.</items>
                <items id="comment">Avsett för att registrera enkla beskrivningar, exempelvis "näsgrimma". Om mer detaljerad beskrivning krävs så kan fältet "Detaljer om administrationssätt" (ett "archetype SLOT") användas .
</items>
            </items>
            <items code="at0057">
                <items id="text">På luft</items>
                <items id="description">Patienten andas vanlig luft, motsvarande 21% O₂ eller 0.21 FiO₂ eller syrgasflöde 0 liter per minut</items>
                <items id="comment">Om "på Luft" är valt (sant) så ska varken syrgasflöde, procent O₂ eller FiO₂ anges. Omvänt gäller att "på Luft" ej ska anges om syrgasflöde, procent O₂ eller FiO₂ anges.</items>
            </items>
            <items code="at0058">
                <items id="text">Detaljer om administrationssätt</items>
                <items id="description">Ytterligare detaljer om administrationssätt för syrgas.</items>
                <items id="comment">Exempelvis detaljer om befuktning eller assisterad ventilation.</items>
            </items>
            <items code="at0000">
                <items id="text">Inandad syrgas</items>
                <items id="description">Mängden syre som ges eller ordineras till patienten, angivet som andel, procent, eller indirekt som syrgasflöde.</items>
            </items>
        </term_definitions>
        <term_definitions language="de">
            <items code="at0051">
                <items id="text">Flussrate</items>
                <items id="description">Sauerstoffflussrate, die einer Person gegeben wird.</items>
                <items id="comment">Zum Beispiel '5 l/min'.</items>
            </items>
            <items code="at0052">
                <items id="text">FiO₂</items>
                <items id="description">Anteil des Sauerstoffs in der eingeatmeten Luft.</items>
                <items id="comment">Zum Beispiel: '0.28'.</items>
            </items>
            <items code="at0053">
                <items id="text">Prozent O₂</items>
                <items id="description">Prozentualer Anteil des Sauerstoffs in der eingeatmeten Luft.</items>
                <items id="comment">Zum Beispiel: '24 %'</items>
            </items>
            <items code="at0054">
                <items id="text">Methode der Sauerstoffzufuhr</items>
                <items id="description">Die benutzte Methode mit der Sauerstoff zugeführt wird.</items>
                <items id="comment">Nur zur Erfassung einfacher Beschreibungen/Begriffe gedacht, z.B.: 'Nasensonde'. Der Slot 'Details zur Sauerstoffzufuhr' kann für detailliertere oder komplexere Erfassung verwendet werden.</items>
            </items>
            <items code="at0057">
                <items id="text">On air</items>
                <items id="description">Der Patient erhält Luft, entsprechend 21% O₂ oder 0,21 FiO₂ und eine Sauerstoff-Flussrate von 0 Liter pro Minute.</items>
                <items id="comment">Wenn "On air" auf "true" gesetzt ist, sollten die Flussrate, FiO₂ und Prozent O₂ nicht aufgezeichnet werden. Umgekehrt sollte 'On air' weggelassen werden, wenn Durchflussrate, FiO₂ oder Prozent O₂ aufgezeichnet werden.</items>
            </items>
            <items code="at0058">
                <items id="text">Details zur Sauerstoffzufuhr</items>
                <items id="description">Weitere Details über die Methode der Sauerstoffzufuhr.</items>
                <items id="comment">Zum Beispiel Details der Befeuchtung oder der assistierten Beatmung.</items>
            </items>
            <items code="at0000">
                <items id="text">Eingeatmeter Sauerstoff</items>
                <items id="description">Die Sauerstoffmenge, die dem Patienten als Fraktion, als Prozentsatz oder indirekt als Flussrate verabreicht wird oder verabreicht werden soll.

</items>
            </items>
        </term_definitions>
    </component_ontologies>
</template>
