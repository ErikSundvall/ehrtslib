                                  <items id="description">Clinergy descriptor</items>
                                </term_definitions>
                                <term_definitions code="at0001">
                                  <items id="text">Frequency</items>
                                  <items id="description">Infrequent, occasional or frequent. symptom_sign and problem_qualifier have no such scale.</items>
                                </term_definitions>
                                <term_definitions code="at0002">
                                  <items id="text">Consistency</items>
                                  <items id="description">Soft, firm, hard or fluctuant swelling.</items>
                                </term_definitions>
                                <term_definitions code="at0003">
                                  <items id="text">Texture</items>
                                  <items id="description">Rough, smooth, nodular or irregular swelling.</items>
                                </term_definitions>
                                <term_definitions code="at0004">
                                  <items id="text">Pain on movement</items>
                                  <items id="description">Pain felt during a tested thumb movement.</items>
                                </term_definitions>
                                <term_definitions code="at0005">
                                  <items id="text">Duration unit</items>
                                  <items id="description">The unit of a duration whose magnitude is stored as DV_DURATION on the symptom.</items>
                                </term_definitions>
