        <items id="description">Additional narrative about the overall physical examination findings not captured in other fields.</items>
      </items>
      <items code="at0012">
        <items id="text">Extension</items>
        <items id="description">Additional information required to capture local content or to align with other reference models/formalisms.</items>
      </items>
      <items code="at0013">
        <items id="text">Position</items>
        <items id="description">The body position of the subject during the examination.</items>
      </items>
      <items code="at0001">
        <items id="text">History</items>
