            <term_definitions code="at0000">
              <items id="text">Symptom/sign screening questionnaire</items>
              <items id="description">Symptom/sign screening questionnaire</items>
            </term_definitions>
            <term_definitions code="at0002">
              <items id="text">Any event</items>
              <items id="description">Default, unspecified point in time or interval event which may be explicitly defined in a template or at run-time.</items>
            </term_definitions>
            <term_definitions code="at0004">
              <items id="text">Symptom/sign name</items>
              <items id="description">Identification of a specific symptom or sign or grouping of symptoms or signs, by name.</items>
            </term_definitions>
            <term_definitions code="at0005">
              <items id="text">Presence?</items>
              <items id="description">Is there a history of the specific symptom or sign being present?</items>
            </term_definitions>
            <term_definitions code="at0021">
              <items id="text">Extension</items>
              <items id="description">Additional information required to extend the model with local content or to align with other reference models or formalisms.</items>
            </term_definitions>
            <term_definitions code="at0022">
              <items id="text">Specific symptom/sign</items>
              <items id="description">Details about a specific symptom or sign or grouping of symptoms or signs relatevant for the screening purpose.</items>
            </term_definitions>
            <term_definitions code="at0023">
              <items id="text">Yes</items>
              <items id="description"/>
            </term_definitions>
            <term_definitions code="at0024">
              <items id="text">No</items>
              <items id="description"/>
            </term_definitions>
            <term_definitions code="at0026">
              <items id="text">Additional details</items>
              <items id="description">Structured details or questions about the specific symptom or sign.</items>
            </term_definitions>
            <term_definitions code="at0027">
              <items id="text">Unknown</items>
              <items id="description"/>
            </term_definitions>
            <term_definitions code="at0028">
              <items id="text">Any symptoms or signs?</items>
              <items id="description">Is there a history of any symptoms or signs relevant for the screening purpose?</items>
            </term_definitions>
            <term_definitions code="at0029">
              <items id="text">Onset</items>
              <items id="description">Timing of the inital recognition of any symptom or sign relevant for the screening purpose.</items>
            </term_definitions>
