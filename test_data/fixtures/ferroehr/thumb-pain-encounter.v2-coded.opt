      <items code="at0034">
        <items id="text">Screening purpose</items>
        <items id="description">The context or reason for screening.</items>
      </items>
      <items code="at0035">
        <items id="text">Comment</items>
        <items id="description">Additional narrative about the specific symptom/sign question, not captured in other fields.</items>
      </items>
      <items code="at0036">
        <items id="text">Description</items>
        <items id="description">Narrative description about the history of any symptoms or signs relevant for the screening purpose.</items>
      </items>
      <items code="at0037">
        <items id="text">Timing</items>
        <items id="description">Indication of timing related to the specific symptom or sign.</items>
      </items>
      <items code="at0039">
        <items id="text">Additional details</items>
        <items id="description">Structured details or questions about screening for symptoms or signs.</items>
      </items>
      <items code="at0040">
        <items id="text">Unsure</items>
        <items id="description"/>
      </items>
      <items code="at0041">
        <items id="text">Unsure</items>
        <items id="description"/>
      </items>
      <items code="at0001">
        <items id="text">History</items>
        <items id="description">History</items>
      </items>
      <items code="at0003">
