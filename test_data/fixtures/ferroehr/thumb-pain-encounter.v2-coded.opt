        <items id="description"/>
      </items>
      <items code="at0028">
        <items id="text">Any symptoms or signs?</items>
        <items id="description">Is there a history of any symptoms or signs relevant for the screening purpose?</items>
      </items>
      <items code="at0029">
        <items id="text">Onset</items>
        <items id="description">Timing of the inital recognition of any symptom or sign relevant for the screening purpose.</items>
      </items>
      <items code="at0031">
